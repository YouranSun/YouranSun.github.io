{"session_id":"b606e9ca-b863-4906-850e-562afca2707c","transcript_path":"/home/youran/.claude/projects/-mnt-d-research-YouranSun-github-io/b606e9ca-b863-4906-850e-562afca2707c.jsonl","cwd":"/mnt/d/research/YouranSun.github.io","permission_mode":"bypassPermissions","effort":{"level":"high"},"hook_event_name":"PreToolUse","tool_name":"Edit","tool_input":{"file_path":"/mnt/d/research/YouranSun.github.io/_includes/scripts.html","old_string":"<script type=\"module\" src=\"{{ base_path }}/assets/js/main.min.js\"></script>\n\n{% include analytics.html %}","new_string":"<script type=\"module\" src=\"{{ base_path }}/assets/js/main.min.js\"></script>\n\n<script>\n(function () {\n  function setupLangToggle() {\n    var label  = document.getElementById(\"lang-toggle-label\");\n    var toggle = document.getElementById(\"lang-toggle\");\n    var savedLang = localStorage.getItem(\"lang\") || \"en\";\n\n    if (savedLang === \"zh\") {\n      document.documentElement.setAttribute(\"data-lang\", \"zh\");\n    } else {\n      document.documentElement.removeAttribute(\"data-lang\");\n    }\n    if (label) label.textContent = (savedLang === \"zh\") ? \"EN\" : \"中\";\n\n    if (toggle) {\n      toggle.addEventListener(\"click\", function () {\n        var current = document.documentElement.getAttribute(\"data-lang\");\n        var newLang = current === \"zh\" ? \"en\" : \"zh\";\n        localStorage.setItem(\"lang\", newLang);\n        if (newLang === \"zh\") {\n          document.documentElement.setAttribute(\"data-lang\", \"zh\");\n          if (label) label.textContent = \"EN\";\n        } else {\n          document.documentElement.removeAttribute(\"data-lang\");\n          if (label) label.textContent = \"中\";\n        }\n      });\n    }\n  }\n\n  if (document.readyState !== \"loading\") {\n    setupLangToggle();\n  } else {\n    document.addEventListener(\"DOMContentLoaded\", setupLangToggle);\n  }\n})();\n</script>\n\n{% include analytics.html %}","replace_all":false},"tool_use_id"