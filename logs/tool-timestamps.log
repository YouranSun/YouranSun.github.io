%A8%E4%BE%86%E4%BA%86-live/1474226597\">7</a>, <a href=\"https://music.apple.com/album/%E9%A3%9B%E8%A1%8C%E5%99%A8%E7%9A%84%E5%9F%B7%E8%A1%8C%E9%80%B1%E6%9C%9F/1443637757\">8</a>, <a href=\"https://music.apple.com/album/%E9%A3%9B%E5%87%BA%E8%BF%B7%E6%A8%93-2024-mix/1775386936\">9</a>, <a href=\"https://music.apple.com/album/%E4%BB%96%E5%80%91%E8%AA%AA%E5%BF%98%E4%BA%86%E6%90%96%E6%BB%BE%E6%9C%89%E5%95%8F%E9%A1%8C/1481432266\">10</a>, <a href=\"https://biupiukiu.net/gq/sxdhf_21demos.zip\">11</a>, <a href=\"https://music.apple.com/us/album/%E9%86%9C%E5%A5%B4%E5%85%92/1676735354\">12</a>, <a href=\"https://music.apple.com/album/%E5%86%AC-%E6%9C%AA%E4%BA%86/1593446659\">13</a>, <a href=\"https://music.apple.com/album/0-7/1752486971\">14</a>, <a href=\"https://music.apple.com/us/album/%E5%8A%B3%E5%8A%A8%E4%B9%8B%E4%BD%99/1597320706\">15</a>, and etc.) for years. <!-- [16](https://music.apple.com/album/%E5%BF%83%E8%A6%81%E9%87%8E/1808445272), [17](https://music.apple.com/album/chinese-football/1237133811), [18](https://music.apple.com/album/%E5%A4%9A%E7%B1%B3%E5%8A%9B%E9%AB%98%E5%A8%81%E5%A8%81%E7%BB%B4%E5%88%A9%E6%98%9F/1563362823), [19](https://music.apple.com/us/album/california-nebula/1459960630), [20](https://music.apple.com/album/%E4%B8%89%E6%B1%9F%E5%A4%9C%E9%81%8A-the-end-of-delusion-and-the-last-ningbonese/1695055680). --> I was in the audience for Omnipotent Youth Hotel（万能青年旅店）'s <a href=\"https://www.bilibili.com/video/BV1Xi421Z7bD\"><em>Inside the Cable Temple</em> Asian Tour</a> in Hong Kong (it was a super awesome performance with passionate audience).</p>","+<p lang=\"zh\">多年来，我是中国摇滚/独立音乐的忠实听众（<a href=\"https://music.apple.com/album/%E4%B8%87%E8%83%BD%E9%9D%92%E5%B9%B4%E6%97%85%E5%BA%97/1538548871\">1</a>、<a href=\"https://music.apple.com/album/%E5%86%80%E8%A5%BF%E5%8D%97%E6%9E%97%E8%B7%AF%E8%A1%8C/1545534900\">2</a>、<a href=\"https://music.apple.com/album/%E8%8F%8A%E8%8A%B1%E5%A4%9C%E8%A1%8C%E8%BB%8D/681818004\">3</a>、<a href=\"https://music.apple.com/album/%E6%96%B0%E9%95%BF%E5%BE%81%E8%B7%AF%E4%B8%8A%E7%9A%84%E6%91%87%E6%BB%9A/1585625540\">4</a>、<a href=\"https://music.apple.com/album/before-the-applause-rebuilding-the-rights-of-statues/1700446170\">5</a>、<a href=\"https://music.apple.com/us/album/%E6%99%82%E4%BB%A3%E5%9C%A8%E5%8F%AC%E5%96%9A/1611249232\">6</a>、<a href=\"https://music.apple.com/album/%E9%A2%B1%E9%A2%A8%E4%BE%86%E4%BA%86-live/1474226597\">7</a>、<a href=\"https://music.apple.com/album/%E9%A3%9B%E8%A1%8C%E5%99%A8%E7%9A%84%E5%9F%B7%E8%A1%8C%E9%80%B1%E6%9C%9F/1443637757\">8</a>、<a href=\"https://music.apple.com/album/%E9%A3%9B%E5%87%BA%E8%BF%B7%E6%A8%93-2024-mix/1775386936\">9</a>、<a href=\"https://music.apple.com/album/%E4%BB%96%E5%80%91%E8%AA%AA%E5%BF%98%E4%BA%86%E6%90%96%E6%BB%BE%E6%9C%89%E5%95%8F%E9%A1%8C/1481432266\">10</a>、<a href=\"https://biupiukiu.net/gq/sxdhf_21demos.zip\">11</a>、<a href=\"https://music.apple.com/us/album/%E9%86%9C%E5%A5%B4%E5%85%92/1676735354\">12</a>、<a href=\"https://music.apple.com/album/%E5%86%AC-%E6%9C%AA%E4%BA%86/1593446659\">13</a>、<a href=\"https://music.apple.com/album/0-7/1752486971\">14</a>、<a href=\"https://music.apple.com/us/album/%E5%8A%B3%E5%8A%A8%E4%B9%8B%E4%BD%99/1597320706\">15</a> 等）。我曾现场观看万能青年旅店的<a href=\"https://www.bilibili.com/video/BV1Xi421Z7bD\">《有线电视的鬼神庙》亚洲巡演</a>香港场，那是一场令人叹为观止的演出，现场观众热情非凡。</p>","+"," <div style=\"display: flex;\">","   <figure style=\"width: 35%; text-align: center;\">","     <img src=\"{{ '/images/万能青年旅店.jpg' | relative_url }}\" style=\"width: 100%;\">","-    <figcaption>Omnipotent Youth Hotel / Inside the Cable Temple Asian Tour / Hong Kong / March 2024</figcaption>","+    <figcaption>","+      <span lang=\"en\">Omnipotent Youth Hotel / Inside the Cable Temple Asian Tour / Hong Kong / March 2024</span>","+      <span lang=\"zh\">万能青年旅店 / 有线电视的鬼神庙亚洲巡演 / 香港 / 2024 年 3 月</span>","+    </figcaption>","   </figure>","-</div>","\\ No newline at end of file","+</div>"]}],"originalFile":"---\ntitle: \"\"\npermalink: /misc/\nauthor_profile: true\n---\n\n🏔️ The virtuous love the mountains. / 仁者乐山。\n=====\n* *The wise love the water; the virtuous love the mountains. (The Analects, Yongye)*\n* *智者乐水，仁者乐山。——《论语 · 雍也》*\n\n<!-- I firmly believe people should behave and act morally. If one cannot fully follow it, at least he should not forget it. -->\n\n<!-- The Mountain stands for silence, strength and steadfastness. It stands there, unshaken by any force. It has a magnanimous heart and supports the rest through its presence, as another saying goes -- *The Earth’s condition is receptive devotion. The superior man, in accordance with this, carries the outer world with his virtue.（“地势坤，君子以厚德载物。”）* -->\n\n🎧 Music\n=====\nI have been a fan of Chinese Rock/Indie ([1](https://music.apple.com/album/%E4%B8%87%E8%83%BD%E9%9D%92%E5%B9%B4%E6%97%85%E5%BA%97/1538548871), [2](https://music.apple.com/album/%E5%86%80%E8%A5%BF%E5%8D%97%E6%9E%97%E8%B7%AF%E8%A1%8C/1545534900), [3](https://music.apple.com/album/%E8%8F%8A%E8%8A%B1%E5%A4%9C%E8%A1%8C%E8%BB%8D/681818004), [4](https://music.apple.com/album/%E6%96%B0%E9%95%BF%E5%BE%81%E8%B7%AF%E4%B8%8A%E7%9A%84%E6%91%87%E6%BB%9A/1585625540), [5](https://music.apple.com/album/before-the-applause-rebuilding-the-rights-of-statues/1700446170), [6](https://music.apple.com/us/album/%E6%99%82%E4%BB%A3%E5%9C%A8%E5%8F%AC%E5%96%9A/1611249232), [7](https://music.apple.com/album/%E9%A2%B1%E9%A2%A8%E4%BE%86%E4%BA%86-live/1474226597), [8](https://music.apple.com/album/%E9%A3%9B%E8%A1%8C%E5%99%A8%E7%9A%84%E5%9F%B7%E8%A1%8C%E9%80%B1%E6%9C%9F/1443637757), [9](https://music.apple.com/album/%E9%A3%9B%E5%87%BA%E8%BF%B7%E6%A8%93-2024-mix/1775386936), [10](https://music.apple.com/album/%E4%BB%96%E5%80%91%E8%AA%AA%E5%BF%98%E4%BA%86%E6%90%96%E6%BB%BE%E6%9C%89%E5%95%8F%E9%A1%8C/1481432266), [11](https://biupiukiu.net/gq/sxdhf_21demos.zip), [12](https://music.apple.com/us/album/%E9%86%9C%E5%A5%B4%E5%85%92/1676735354), [13](https://music.apple.com/album/%E5%86%AC-%E6%9C%AA%E4%BA%86/1593446659), [14](https://m