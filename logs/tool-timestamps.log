{"session_id":"b606e9ca-b863-4906-850e-562afca2707c","transcript_path":"/home/youran/.claude/projects/-mnt-d-research-YouranSun-github-io/b606e9ca-b863-4906-850e-562afca2707c.jsonl","cwd":"/mnt/d/research/YouranSun.github.io","permission_mode":"bypassPermissions","effort":{"level":"high"},"hook_event_name":"PostToolUse","tool_name":"Read","tool_input":{"file_path":"/mnt/d/research/YouranSun.github.io/_pages/competitive-programming.md","offset":36,"limit":30},"tool_response":{"type":"text","file":{"filePath":"/mnt/d/research/YouranSun.github.io/_pages/competitive-programming.md","content":"<ul>\n  <li lang=\"en\">🥇<strong>Champion</strong> (1st place) -- <a href=\"https://rl.algoux.org/ranklist/ccpc2025ladies\">The 11<sup>th</sup> CCPC Girls' Division</a>, Oct 2025</li>\n  <li lang=\"zh\">🥇<strong>冠军</strong>（第 1 名）——<a href=\"https://rl.algoux.org/ranklist/ccpc2025ladies\">第十一届 CCPC 女生专场</a>，2025 年 10 月</li>\n  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (26th place) -- <a href=\"https://board.xcpcio.com/icpc/49th/ecfinal?group=official\">The 49<sup>th</sup> ICPC Asia East Continent Final Contest</a>, Dec 2024</li>\n  <li lang=\"zh\">🏆<strong>金奖</strong>（第 26 名）——<a href=\"https://board.xcpcio.com/icpc/49th/ecfinal?group=official\">第 49 届 ICPC 东亚区决赛</a>，2024 年 12 月</li>\n  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (6th place) -- <a href=\"https://board.xcpcio.com/icpc/49th/hongkong?group=official\">The 49<sup>th</sup> ICPC Asia Hong Kong Regional Contest</a>, Dec 2024</li>\n  <li lang=\"zh\">🏆<strong>金奖</strong>（第 6 名）——<a href=\"https://board.xcpcio.com/icpc/49th/hongkong?group=official\">第 49 届 ICPC 亚洲区域赛香港站</a>，2024 年 12 月</li>\n  <li lang=\"en\">🥉<strong>2nd Runner-up</strong> (3rd place) -- <a href=\"https://board.xcpcio.com/ccpc/10th/zhengzhou?group=official\">The 10<sup>th</sup> CCPC Zhengzhou site</a>, Nov 2024</li>\n  <li lang=\"zh\">🥉<strong>季军</strong>（第 3 名）——<a href=\"https://board.xcpcio.com/ccpc/10th/zhengzhou?group=official\">第十届 CCPC 国赛（郑州）</a>，2024 年 11 月</li>\n  <li lang=\"en\">🥈<strong>1st Runner-up</strong> (2nd place) -- <a href=\"https://rl.algoux.org/ranklist/ccpc2024ladies\">The 10<sup>th</sup> CCPC Girls' Division</a>, Nov 2024</li>\n  <li lang=\"zh\">🥈<strong>亚军</strong>（第 2 名）——<a href=\"https://rl.algoux.org/ranklist/ccpc2024ladies\">第十届 CCPC 女生专场</a>，2024 年 11 月</li>\n  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (16th place) -- <a href=\"https://board.xcpcio.com/icpc/49th/chengdu?group=official\">The 49<sup>th</sup> ICPC Asia Chengdu Regional Contest</a>, Oct 2024</li>\n  <li lang=\"zh\">🏆<strong>金奖</strong>（第 16 名）——<a href=\"https://board.xcpcio.com/icpc/49th/chengdu?group=official\">第 49 届 ICPC 亚洲区域赛成都站</a>，2024 年 10 月</li>\n  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (19th place) -- <a href=\"https://board.xcpcio.com/ccpc/10th/harbin?group=official\">The 10<sup>th</sup> CCPC Harbin Site</a>, Oct 2024</li>\n  <li lang=\"zh\">🏆<strong>金奖</strong>（第 19 名）——<a href=\"https://board.xcpcio.com/ccpc/10th/harbin?group=official\">第十届 CCPC 国赛（哈尔滨）</a>，2024 年 10 月</li>\n  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (17th place) -- <a href=\"https://board.xcpcio.com/icpc/48th/nanjing?group=official\">The 48<sup>th</sup> ICPC Asia Nanjing Regional Contest</a>, Nov 2023</li>\n  <li lang=\"zh\">🏆<strong>金牌</strong>（第 17 名）——<a href=\"https://board.xcpcio.com/icpc/48th/nanjing?group=official\">第 48 届 ICPC 亚洲区域赛南京站</a>，2023 年 11 月</li>\n</ul>\n\n<p lang=\"en\"><strong>High school</strong></p>\n<p lang=\"zh\"><strong>高中</strong></p>\n\n<ul>\n  <li lang=\"en\">🥉<strong>Bronze Medalist</strong> -- <a href=\"https://www.noi.cn/upload/resources/file/2024/06/03/75fa469e47f6785fcb88c3dc01a7ec81.htm\">National Olympiad in Informatics</a>, Aug 2022</li>\n  <li lang=\"zh\">🥉<strong>铜牌</strong>——<a href=\"https://www.noi.cn/upload/resources/file/2024/06/03/75fa469e47f6785fcb88c3dc01a7ec81.htm\">全国信息学奥林匹克竞赛（NOI）</a>，2022 年 8 月</li>\n  <li lang=\"en\">🏆<strong>1st Prize</strong> (1st place) -- <a href=\"https://www.noi.cn/upload/resources/file/2022/05/07/202205070930.htm\">National Olympiad in Informatics, Girls' Contest</a>, May 2022</li>\n  <li lang=\"zh\">🏆<strong>一等奖</strong>（第 1 名）——<a href=\"https://www.noi.cn/upload/resources/file/2022/05/07/202205070930.htm\">全国信息学奥林匹克女生赛</a>，2022 年 5 月</li>\n  <li lang=\"en\">🥈<strong>Silver Medalist</strong> -- <a href=\"https://www.noi.cn/upload/resources/file/2021/08/23/165993.html\">National Olympiad in Informatics Summer Camp</a>, Jul 2021</li>\n  <li lang=\"zh\">🥈<strong>银牌</strong>——<a href=\"https://www.noi.cn/upload/resources/file/2021/08/23/165993.html\">全国信息学奥林匹克竞赛夏令营（D 类选手）</a>，2021 年 7 月</li>\n</ul>","numLines":30,"startLine":36,"totalLines":90}},"tool_use_id":"toolu_01GK6628oVSV6D4ho3PfJ2Ps","duration_ms":56,"logged_at":"2026-06-18T13:47:27"}
