padding-bottom: 5px;\n    font-family: $sans-serif-narrow;\n    font-size: $type-size-6;\n    text-transform: uppercase;\n  }\n\n  li + li:before {\n    content: \"\";\n    padding-right: 5px;\n  }\n\n  a {\n    padding-right: 10px;\n    font-weight: bold;\n  }\n\n  .social-icons {\n    a {\n      white-space: nowrap;\n    }\n  }\n}\n","numLines":97,"startLine":1,"totalLines":97}},"tool_use_id":"toolu_01E2m2vGKqM1fCaDgy9N1nYu","duration_ms":13,"logged_at":"2026-05-11T05:10:54"}
