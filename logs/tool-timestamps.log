{"session_id":"b606e9ca-b863-4906-850e-562afca2707c","transcript_path":"/home/youran/.claude/projects/-mnt-d-research-YouranSun-github-io/b606e9ca-b863-4906-850e-562afca2707c.jsonl","cwd":"/mnt/d/research/YouranSun.github.io","permission_mode":"bypassPermissions","effort":{"level":"high"},"hook_event_name":"PostToolUse","tool_name":"Edit","tool_input":{"file_path":"/mnt/d/research/YouranSun.github.io/_sass/layout/_base.scss","old_string":"/* ==========================================================================\n   PRINT STYLES\n   ========================================================================== */","new_string":"/* ==========================================================================\n   LANGUAGE SWITCHING\n   ========================================================================== */\n\n[lang=\"zh\"] { display: none; }\nhtml[data-lang=\"zh\"] [lang=\"zh\"] { display: revert; }\nhtml[data-lang=\"zh\"] [lang=\"en\"] { display: none; }\n\n/* ==========================================================================\n   PRINT STYLES\n   ========================================================================== */","replace_all":false},"tool_response":{"filePath":"/mnt/d/research/YouranSun.github.io/_sass/layout/_base.scss","oldString":"/* ==========================================================================\n   PRINT STYLES\n   ========================================================================== */","newString":"/* ==========================================================================\n   LANGUAGE SWITCHING\n   ========================================================================== */\n\n[lang=\"zh\"] { display: none; }\nhtml[data-lang=\"zh\"] [lang=\"zh\"] { display: revert; }\nhtml[data-lang=\"zh\"] [lang=\"en\"] { display: none; }\n\n/* ==========================================================================\n   PRINT STYLES\n   ========================================================================== */","originalFile":"/* ==========================================================================\n   BASE ELEMENTS\n   ========================================================================== */\nhtml {\n  min-height: 100%;\n}\n\nbody {\n  /* Set via _themes.scss */\n  color: var(--global-text-color);\n  background-color: var(--global-bg-color);\n\n  margin: 0;\n  padding: $masthead-height 0 0;\n  font-family: $global-font-family;\n  line-height: 1.5;\n  height: 100vh;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n\n  &.overflow--hidden {\n    /* when primary navigation is visible, the content in the background won't scroll */\n    overflow: hidden;\n  }\n}\n\nh1, h2, h3, h4, h5, h6 {\n  margin: 2em 0 0.5em;\n  line-height: 1.2;\n  font-family: $header-font-family;\n  font-weight: bold;\n}\n\nh1 {\n  margin-top: 0;\n  font-size: 1.5em;\n}\n\nh2 {\n  font-size: 1.25em;\n}\n\nh3 {\n  font-size: 1.1em;\n}\n\nh4 {\n  font-size: $type-size-6;\n}\n\nh5 {\n  font-size: $type-size-6;\n}\n\nh6 {\n  font-size: $type-size-6;\n}\n\nsmall, .small {\n  font-size: $type-size-6;\n}\n\np {\n  margin-bottom: 1.3em;\n}\n\nu,\nins {\n  text-decoration: none;\n  border-bottom: 1px solid var(--global-text-color);\n  a {\n    color: inherit;\n  }\n}\n\ndel a {\n  color: inherit;\n}\n\n/* reduce orphans and widows when printing */\n\np, pre, blockquote, ul, ol, dl, figure, table, fieldset {\n  orphans: 3;\n  widows: 3;\n}\n\n/* abbreviations */\n\nabbr[title],\nabbr[data-original-title] {\n  text-decoration: none;\n  cursor: help;\n  border-bottom: 1px dotted var(--global-text-color);\n}\n\n/* blockquotes */\n\nblockquote {\n  margin: 2em 1em 2em 0;\n  padding-left: 1em;\n  padding-right: 1em;\n  font-style: italic;\n  border-left: 0.25em solid var(--global-border-color);\n\n  cite {\n    font-style: italic;\n\n    &:before {\n      content: \"\\2014\";\n      padding-right: 5px;\n    }\n  }\n}\n\n/* links */\n\na {\n  &:focus {\n    @extend %tab-focus;\n  }\n\n  &:hover,\n  &:active {\n    outline: 0;\n  }\n}\n\n/* code */\n\ntt, code, kbd, samp, pre {\n  font-family: $monospace;\n}\n\npre {\n  overflow-x: auto; /* add scrollbars to wide code blocks*/\n}\n\na > code,\nfigcaption > code,\nli > code,\np > code,\ntd > code {\n  color: var(--global-code-text-color);\n  padding-top: 0.1rem;\n  padding-bottom: 0.1rem;\n  font-size: $type-size-6;\n  background: var(--global-code-background-color);\n  border: 1px solid var(--global-thead-color);\n  border-radius: $border-radius;\n  box-shadow: $box-shadow;\n\n  &:before, &:after {\n    letter-spacing: -0.2em;\n    content: \"\\00a0\"; /* non-breaking space*/\n  }\n}\n\na > code {\n    color: inherit;\n}\n\npre > code {\n  color: var(--global-code-text-color);\n}\n\n/* horizontal rule */\n\nhr {\n  display: block;\n  margin: 1em 0;\n  border: 0;\n  border-top: 1px solid var(--global-border-color);\n}\n\n/* lists */\n\nul li,\nol li {\n  margin-bottom: 0.5em;\n}\n\nli ul,\nli ol {\n  margin-top: 0.5em;\n}\n\n/*\n   Media and embeds\n   ========================================================================== */\n\n/* Figures and images */\n\nfigure {\n  display: -webkit-box;\n  display: flex;\n  -webkit-box-pack: justify;\n          justify-content: space-between;\n  -webkit-box-align: start;\n          align-items: flex-start;\n  flex-wrap: wrap;\n  margin: 2em 0;\n\n  img,\n  iframe,\n  .fluid-width-video-wrapper {\n    margin-bottom: 1em;\n  }\n\n  img {\n    width: 100%;\n    border-radius: $border-radius;\n    -webkit-transition: $global-transition;\n    transition: $global-transition;\n  }\n\n  > a {\n    display: block;\n  }\n\n  &.half {\n    > a,\n    > img {\n      @include breakpoint($small) {\n        width: calc(50% - 0.5em);\n      }\n    }\n\n    figcaption {\n      width: 100%;\n    }\n  }\n\n  &.third {\n    > a,\n    > img {\n      @include breakpoint($small) {\n        width: calc(33.3333% - 0.5em);\n      }\n    }\n\n    figcaption {\n      width: 100%;\n    }\n  }\n}\n\n/* Figure captions */\n\nfigcaption {\n  margin-bottom: 0.5em;\n  color: var(--global-fig-caption-color);\n  font-family: $caption-font-family;\n  font-size: $type-size-6;\n\n  a {\n    color: inherit;\n    text-decoration: none;\n    border-bottom: 1px solid var(--global-border-color );\n    -webkit-transition: $global-transition;\n    transition: $global-transition;\n\n    &:hover {\n      color: #000;\n      border-bottom-color: #000;\n    }\n  }\n}\n\n\n/* Fix IE9 SVG bug */\n\nsvg:not(:root) {\n  overflow: hidden;\n}\n\n\n/*\n   Navigation lists\n   ========================================================================== */\n\n/**\n * Removes margins, padding, and bullet points from navigation lists\n *\n * Example usage:\n * <nav>\n *    <ul>\n *      <li><a href=\"#link-1\">Link 1</a></li>\n *      <li><a href=\"#link-2\">Link 2</a></li>\n *      <li><a href=\"#link-3\">Link 3</a></li>\n *    </ul>\n *  </nav>\n */\n\nnav {\n  ul {\n    margin: 0;\n    padding: 0;\n  }\n\n  li {\n    list-style: none;\n  }\n\n  a {\n    text-decoration: none;\n  }\n\n  /* override white-space for nested lists */\n  ul li,\n  ol li {\n    margin-bottom: 0;\n  }\n\n  li ul,\n  li ol {\n    margin-top: 0;\n  }\n}\n\n/* ==========================================================================\n   ANIMATIONS\n   ========================================================================== */\n\n   @-webkit-keyframes intro {\n    0% {\n      opacity: 0;\n    }\n    100% {\n      opacity: 1;\n    }\n  }\n  \n  @keyframes intro {\n    0% {\n      opacity: 0;\n    }\n    100% {\n      opacity: 1;\n    }\n  }\n\n/* Global animation transition */\nb, i, strong, em, blockquote, p, q, span, figure, img, h1, h2, header, input, a, tr, td, form button, input[type=\"submit\"], .btn, .highlight, .archive__item-teaser {\n  -webkit-transition: $global-transition;\n  transition: $global-transition;\n}\n\n/* ==========================================================================\n   PRINT STYLES\n   ========================================================================== */\n\n/*\n   Hide the following elements on print\n   ========================================================================== */\n\n   @media print {\n    .masthead,\n    .toc,\n    .page__share,\n    .page__related,\n    .ads,\n    .page__footer {\n      display: none;\n    }\n  }\n","structuredPatch":[{"oldStart":347,"oldLines":6,"newStart":347,"newLines":14,"lines":[" }"," "," /* ==========================================================================","+   LANGUAGE SWITCHING","+   ========================================================================== */","+","+[lang=\"zh\"] { display: none; }","+html[data-lang=\"zh\"] [lang=\"zh\"] { display: revert; }","+html[data-lang=\"zh\"] [lang=\"en\"] { display: none; }","+","+/* ==========================================================================","    PRINT STYLES","    ========================================================================== */"," "]}],"userModified":false,"replaceAll":false},"tool_use_id":"toolu_014kZYGgSzDV7eUEVcU1iYga","duration_ms":142,"logged_at":"2026-06-17T23:22:45"}
{"session_id":"b606e9ca-b863-4906-850e-562afca2707c","transcript_path":"/home/youran/.claude/projects/-mnt-d-research-YouranSun-github-io/b606e9ca-b863-4906-850e-562afca2707c.jsonl","cwd":"/mnt/d/research/YouranSun.github.io","permission_mode":"bypassPermissions","effort":{"level":"high"},"hook_event_name":"PreToolUse","tool_name":"Write","tool_input":{"file_path":"/mnt/d/research/YouranSun.github.io/_pages/about.md","content":"---\npermalink: /\ntitle: \"Youran Sun 孙悠然\"\nauthor_profile: true\nredirect_from: \n  - /about/\n  - /about.html\n---\n\n<p lang=\"en\">I'm a junior undergraduate at The Chinese University of Hong Kong, Shenzhen, double majoring in <em>Computer Science and Engineering</em> and <em>Interdisciplinary Data Analytics</em>.</p>\n<p lang=\"zh\">我是香港中文大学（深圳）大三本科生，双主修<em>计算机科学与工程</em>与<em>跨学科数据分析</em>。</p>\n\n<p lang=\"en\">My research interests mainly lie in <strong>Data agents</strong> and <strong>LLM-powered data processing</strong>. One set of questions I have been thinking about is how to build agentic data systems for hard data tasks, particularly: (1) what roles agents could play in solving data tasks and as components of database systems; (2) how agents should interact with databases, and how to build agent-friendly data environments; and (3) how to make data agents and agentic data systems work efficiently and reliably.\nPrior to this, I also had rich experience in <strong>Graph data management</strong>.</p>\n<p lang=\"zh\">我的研究兴趣主要集中在<strong>数据智能体</strong>和<strong>大语言模型驱动的数据处理</strong>。我一直思考的核心问题是：如何为复杂数据任务构建智能体数据系统，具体包括：（1）智能体在求解数据任务及作为数据库系统组件时能扮演什么角色；（2）智能体应如何与数据库交互，以及如何构建对智能体友好的数据环境；（3）如何使数据智能体及智能体数据系统高效、可靠地运行。此前，我在<strong>图数据管理</strong>领域也积累了丰富的研究经验。</p>\n\n<blockquote lang=\"en\">I am now actively seeking a PhD position for Fall 2027!</blockquote>\n<blockquote lang=\"zh\">我正在积极寻求 2027 年秋季入学的博士项目！</blockquote>\n\n<h2 id=\"experience\"><span lang=\"en\">Experience</span><span lang=\"zh\">经历</span></h2>\n\n<p lang=\"en\">I'm in the first cohort of CUHK's <a href=\"https://www.idadm.cdmp.cuhk.edu.hk/\">IDADM</a> programme, which offered a collaborated double major bachelor education across both Hong Kong and Shenzhen campuses of CUHK, two years at each site.</p>\n<p lang=\"zh\">我是港中大 <a href=\"https://www.idadm.cdmp.cuhk.edu.hk/\">IDADM</a> 项目的首届学生。该项目提供香港与深圳两个校区联合培养的双学士学位教育，各驻校两年。</p>\n\n<p lang=\"en\">During my college study, I have been consistently studying various topics about databases at these places:</p>\n<p lang=\"zh\">大学期间，我持续在以下机构深耕数据库相关方向的研究：</p>\n\n<ul>\n  <li lang=\"en\">(2026.5 - now) I'm having a research intern in <strong>Tsinghua University</strong> Database Group, supervised by <strong><a href=\"https://dbgroup.cs.tsinghua.edu.cn/ligl/\">Prof. Guoliang Li</a></strong> and <a href=\"https://sunji.greatji.com/\">Prof. Ji Sun</a>.</li>\n  <li lang=\"zh\">（2026.5 至今）我正在<strong>清华大学</strong>数据库研究组实习，导师为<strong><a href=\"https://dbgroup.cs.tsinghua.edu.cn/ligl/\">李国良教授</a></strong>和<a href=\"https://sunji.greatji.com/\">孙冀教授</a>。</li>\n  <li lang=\"en\">(2026.1 - 2026.5) I visited <strong>UC Berkeley</strong>, where I had the privilege of being supervised by <strong><a href=\"https://people.eecs.berkeley.edu/~adityagp/\">Prof. Aditya Parameswaran</a></strong> and gained a both enjoyable and rewarding collaboration with <a href=\"https://szeighami.github.io/\">Dr. Sepanta Zeighami</a> in the <a href=\"https://epic.berkeley.edu/\">EPIC Data lab</a>.</li>\n  <li lang=\"zh\">（2026.1 — 2026.5）我访问了<strong>加州大学伯克利分校</strong>，有幸师从<strong><a href=\"https://people.eecs.berkeley.edu/~adityagp/\">Aditya Parameswaran 教授</a></strong>，并在 <a href=\"https://epic.berkeley.edu/\">EPIC Data 实验室</a>与<a href=\"https://szeighami.github.io/\">Sepanta Zeighami 博士</a>开展了愉快而富有成效的合作研究。</li>\n  <li lang=\"en\">(2024.1 - 2025.12) At <strong>CUHK-Shenzhen</strong>, I was supervised by <strong><a href=\"https://fangyixiang.github.io/\">Prof. Yixiang Fang</a></strong> and had the pleasure working closely with <a href=\"https://jaylzhou.github.io/\">Dr. Yingli Zhou</a>, where I was first introduced to academic research and databases.</li>\n  <li lang=\"zh\">（2024.1 — 2025.12）在<strong>港中大（深圳）</strong>，我师从<strong><a href=\"https://fangyixiang.github.io/\">方怡翔教授</a></strong>，并有幸与<a href=\"https://jaylzhou.github.io/\">周颖丽博士</a>紧密合作，在这里我初次接触到学术研究与数据库领域。</li>\n</ul>\n\n<h2 id=\"interests\"><span lang=\"en\">Interests</span><span lang=\"zh\">研究方向</span></h2>\n\n<p lang=\"en\">I've been participating in research projects on the following topics:</p>\n<p lang=\"zh\">我参与过以下方向的研究项目：</p>\n\n<ul>\n  <li lang=\"en\"><strong>Data agents:</strong> Cost estimation and optimization for data agents.</li>\n  <li lang=\"zh\"><strong>数据智能体：</strong>数据智能体的代价估算与优化。</li>\n  <li lang=\"en\"><strong>LLM-powered data processing:</strong> Data understanding of semantic data processing.</li>\n  <li lang=\"zh\"><strong>大模型驱动的数据处理：</strong>语义数据处理中的数据理解。</li>\n  <li lang=\"en\"><strong>RAG systems:</strong> Graph RAG prototype system, knob-tuning for RAGs.</li>\n  <li lang=\"zh\"><strong>RAG 系统：</strong>图 RAG 原型系统、RAG 参数调优。</li>\n  <li lang=\"en\"><strong>Graph data management:</strong>  Community search, densest subgraph discovery algorithms.</li>\n  <li lang=\"zh\"><strong>图数据管理：</strong>社区搜索、最密子图发现算法。</li>\n</ul>\n"},"tool_use_id":"toolu_01Q8wfoHG6LoBhDQ6fQ22wqj","logged_at":"2026-06-17T23:23:21"}
{"session_id":"b606e9ca-b863-4906-850e-562afca2707c","transcript_path":"/home/youran/.claude/projects/-mnt-d-research-YouranSun-github-io/b606e9ca-b863-4906-850e-562afca2707c.jsonl","cwd":"/mnt/d/research/YouranSun.github.io","permission_mode":"bypassPermissions","effort":{"level":"high"},"hook_event_name":"PostToolUse","tool_name":"Write","tool_input":{"file_path":"/mnt/d/research/YouranSun.github.io/_pages/about.md","content":"---\npermalink: /\ntitle: \"Youran Sun 孙悠然\"\nauthor_profile: true\nredirect_from: \n  - /about/\n  - /about.html\n---\n\n<p lang=\"en\">I'm a junior undergraduate at The Chinese University of Hong Kong, Shenzhen, double majoring in <em>Computer Science and Engineering</em> and <em>Interdisciplinary Data Analytics</em>.</p>\n<p lang=\"zh\">我是香港中文大学（深圳）大三本科生，双主修<em>计算机科学与工程</em>与<em>跨学科数据分析</em>。</p>\n\n<p lang=\"en\">My research interests mainly lie in <strong>Data agents</strong> and <strong>LLM-powered data processing</strong>. One set of questions I have been thinking about is how to build agentic data systems for hard data tasks, particularly: (1) what roles agents could play in solving data tasks and as components of database systems; (2) how agents should interact with databases, and how to build agent-friendly data environments; and (3) how to make data agents and agentic data systems work efficiently and reliably.\nPrior to this, I also had rich experience in <strong>Graph data management</strong>.</p>\n<p lang=\"zh\">我的研究兴趣主要集中在<strong>数据智能体</strong>和<strong>大语言模型驱动的数据处理</strong>。我一直思考的核心问题是：如何为复杂数据任务构建智能体数据系统，具体包括：（1）智能体在求解数据任务及作为数据库系统组件时能扮演什么角色；（2）智能体应如何与数据库交互，以及如何构建对智能体友好的数据环境；（3）如何使数据智能体及智能体数据系统高效、可靠地运行。此前，我在<strong>图数据管理</strong>领域也积累了丰富的研究经验。</p>\n\n<blockquote lang=\"en\">I am now actively seeking a PhD position for Fall 2027!</blockquote>\n<blockquote lang=\"zh\">我正在积极寻求 2027 年秋季入学的博士项目！</blockquote>\n\n<h2 id=\"experience\"><span lang=\"en\">Experience</span><span lang=\"zh\">经历</span></h2>\n\n<p lang=\"en\">I'm in the first cohort of CUHK's <a href=\"https://www.idadm.cdmp.cuhk.edu.hk/\">IDADM</a> programme, which offered a collaborated double major bachelor education across both Hong Kong and Shenzhen campuses of CUHK, two years at each site.</p>\n<p lang=\"zh\">我是港中大 <a href=\"https://www.idadm.cdmp.cuhk.edu.hk/\">IDADM</a> 项目的首届学生。该项目提供香港与深圳两个校区联合培养的双学士学位教育，各驻校两年。</p>\n\n<p lang=\"en\">During my college study, I have been consistently studying various topics about databases at these places:</p>\n<p lang=\"zh\">大学期间，我持续在以下机构深耕数据库相关方向的研究：</p>\n\n<ul>\n  <li lang=\"en\">(2026.5 - now) I'm having a research intern in <strong>Tsinghua University</strong> Database Group, supervised by <strong><a href=\"https://dbgroup.cs.tsinghua.edu.cn/ligl/\">Prof. Guoliang Li</a></strong> and <a href=\"https://sunji.greatji.com/\">Prof. Ji Sun</a>.</li>\n  <li lang=\"zh\">（2026.5 至今）我正在<strong>清华大学</strong>数据库研究组实习，导师为<strong><a href=\"https://dbgroup.cs.tsinghua.edu.cn/ligl/\">李国良教授</a></strong>和<a href=\"https://sunji.greatji.com/\">孙冀教授</a>。</li>\n  <li lang=\"en\">(2026.1 - 2026.5) I visited <strong>UC Berkeley</strong>, where I had the privilege of being supervised by <strong><a href=\"https://people.eecs.berkeley.edu/~adityagp/\">Prof. Aditya Parameswaran</a></strong> and gained a both enjoyable and rewarding collaboration with <a href=\"https://szeighami.github.io/\">Dr. Sepanta Zeighami</a> in the <a href=\"https://epic.berkeley.edu/\">EPIC Data lab</a>.</li>\n  <li lang=\"zh\">（2026.1 — 2026.5）我访问了<strong>加州大学伯克利分校</strong>，有幸师从<strong><a href=\"https://people.eecs.berkeley.edu/~adityagp/\">Aditya Parameswaran 教授</a></strong>，并在 <a href=\"https://epic.berkeley.edu/\">EPIC Data 实验室</a>与<a href=\"https://szeighami.github.io/\">Sepanta Zeighami 博士</a>开展了愉快而富有成效的合作研究。</li>\n  <li lang=\"en\">(2024.1 - 2025.12) At <strong>CUHK-Shenzhen</strong>, I was supervised by <strong><a href=\"https://fangyixiang.github.io/\">Prof. Yixiang Fang</a></strong> and had the pleasure working closely with <a href=\"https://jaylzhou.github.io/\">Dr. Yingli Zhou</a>, where I was first introduced to academic research and databases.</li>\n  <li lang=\"zh\">（2024.1 — 2025.12）在<strong>港中大（深圳）</strong>，我师从<strong><a href=\"https://fangyixiang.github.io/\">方怡翔教授</a></strong>，并有幸与<a href=\"https://jaylzhou.github.io/\">周颖丽博士</a>紧密合作，在这里我初次接触到学术研究与数据库领域。</li>\n</ul>\n\n<h2 id=\"interests\"><span lang=\"en\">Interests</span><span lang=\"zh\">研究方向</span></h2>\n\n<p lang=\"en\">I've been participating in research projects on the following topics:</p>\n<p lang=\"zh\">我参与过以下方向的研究项目：</p>\n\n<ul>\n  <li lang=\"en\"><strong>Data agents:</strong> Cost estimation and optimization for data agents.</li>\n  <li lang=\"zh\"><strong>数据智能体：</strong>数据智能体的代价估算与优化。</li>\n  <li lang=\"en\"><strong>LLM-powered data processing:</strong> Data understanding of semantic data processing.</li>\n  <li lang=\"zh\"><strong>大模型驱动的数据处理：</strong>语义数据处理中的数据理解。</li>\n  <li lang=\"en\"><strong>RAG systems:</strong> Graph RAG prototype system, knob-tuning for RAGs.</li>\n  <li lang=\"zh\"><strong>RAG 系统：</strong>图 RAG 原型系统、RAG 参数调优。</li>\n  <li lang=\"en\"><strong>Graph data management:</strong>  Community search, densest subgraph discovery algorithms.</li>\n  <li lang=\"zh\"><strong>图数据管理：</strong>社区搜索、最密子图发现算法。</li>\n</ul>\n"},"tool_response":{"type":"update","filePath":"/mnt/d/research/YouranSun.github.io/_pages/about.md","content":"---\npermalink: /\ntitle: \"Youran Sun 孙悠然\"\nauthor_profile: true\nredirect_from: \n  - /about/\n  - /about.html\n---\n\n<p lang=\"en\">I'm a junior undergraduate at The Chinese University of Hong Kong, Shenzhen, double majoring in <em>Computer Science and Engineering</em> and <em>Interdisciplinary Data Analytics</em>.</p>\n<p lang=\"zh\">我是香港中文大学（深圳）大三本科生，双主修<em>计算机科学与工程</em>与<em>跨学科数据分析</em>。</p>\n\n<p lang=\"en\">My research interests mainly lie in <strong>Data agents</strong> and <strong>LLM-powered data processing</strong>. One set of questions I have been thinking about is how to build agentic data systems for hard data tasks, particularly: (1) what roles agents could play in solving data tasks and as components of database systems; (2) how agents should interact with databases, and how to build agent-friendly data environments; and (3) how to make data agents and agentic data systems work efficiently and reliably.\nPrior to this, I also had rich experience in <strong>Graph data management</strong>.</p>\n<p lang=\"zh\">我的研究兴趣主要集中在<strong>数据智能体</strong>和<strong>大语言模型驱动的数据处理</strong>。我一直思考的核心问题是：如何为复杂数据任务构建智能体数据系统，具体包括：（1）智能体在求解数据任务及作为数据库系统组件时能扮演什么角色；（2）智能体应如何与数据库交互，以及如何构建对智能体友好的数据环境；（3）如何使数据智能体及智能体数据系统高效、可靠地运行。此前，我在<strong>图数据管理</strong>领域也积累了丰富的研究经验。</p>\n\n<blockquote lang=\"en\">I am now actively seeking a PhD position for Fall 2027!</blockquote>\n<blockquote lang=\"zh\">我正在积极寻求 2027 年秋季入学的博士项目！</blockquote>\n\n<h2 id=\"experience\"><span lang=\"en\">Experience</span><span lang=\"zh\">经历</span></h2>\n\n<p lang=\"en\">I'm in the first cohort of CUHK's <a href=\"https://www.idadm.cdmp.cuhk.edu.hk/\">IDADM</a> programme, which offered a collaborated double major bachelor education across both Hong Kong and Shenzhen campuses of CUHK, two years at each site.</p>\n<p lang=\"zh\">我是港中大 <a href=\"https://www.idadm.cdmp.cuhk.edu.hk/\">IDADM</a> 项目的首届学生。该项目提供香港与深圳两个校区联合培养的双学士学位教育，各驻校两年。</p>\n\n<p lang=\"en\">During my college study, I have been consistently studying various topics about databases at these places:</p>\n<p lang=\"zh\">大学期间，我持续在以下机构深耕数据库相关方向的研究：</p>\n\n<ul>\n  <li lang=\"en\">(2026.5 - now) I'm having a research intern in <strong>Tsinghua University</strong> Database Group, supervised by <strong><a href=\"https://dbgroup.cs.tsinghua.edu.cn/ligl/\">Prof. Guoliang Li</a></strong> and <a href=\"https://sunji.greatji.com/\">Prof. Ji Sun</a>.</li>\n  <li lang=\"zh\">（2026.5 至今）我正在<strong>清华大学</strong>数据库研究组实习，导师为<strong><a href=\"https://dbgroup.cs.tsinghua.edu.cn/ligl/\">李国良教授</a></strong>和<a href=\"https://sunji.greatji.com/\">孙冀教授</a>。</li>\n  <li lang=\"en\">(2026.1 - 2026.5) I visited <strong>UC Berkeley</strong>, where I had the privilege of being supervised by <strong><a href=\"https://people.eecs.berkeley.edu/~adityagp/\">Prof. Aditya Parameswaran</a></strong> and gained a both enjoyable and rewarding collaboration with <a href=\"https://szeighami.github.io/\">Dr. Sepanta Zeighami</a> in the <a href=\"https://epic.berkeley.edu/\">EPIC Data lab</a>.</li>\n  <li lang=\"zh\">（2026.1 — 2026.5）我访问了<strong>加州大学伯克利分校</strong>，有幸师从<strong><a href=\"https://people.eecs.berkeley.edu/~adityagp/\">Aditya Parameswaran 教授</a></strong>，并在 <a href=\"https://epic.berkeley.edu/\">EPIC Data 实验室</a>与<a href=\"https://szeighami.github.io/\">Sepanta Zeighami 博士</a>开展了愉快而富有成效的合作研究。</li>\n  <li lang=\"en\">(2024.1 - 2025.12) At <strong>CUHK-Shenzhen</strong>, I was supervised by <strong><a href=\"https://fangyixiang.github.io/\">Prof. Yixiang Fang</a></strong> and had the pleasure working closely with <a href=\"https://jaylzhou.github.io/\">Dr. Yingli Zhou</a>, where I was first introduced to academic research and databases.</li>\n  <li lang=\"zh\">（2024.1 — 2025.12）在<strong>港中大（深圳）</strong>，我师从<strong><a href=\"https://fangyixiang.github.io/\">方怡翔教授</a></strong>，并有幸与<a href=\"https://jaylzhou.github.io/\">周颖丽博士</a>紧密合作，在这里我初次接触到学术研究与数据库领域。</li>\n</ul>\n\n<h2 id=\"interests\"><span lang=\"en\">Interests</span><span lang=\"zh\">研究方向</span></h2>\n\n<p lang=\"en\">I've been participating in research projects on the following topics:</p>\n<p lang=\"zh\">我参与过以下方向的研究项目：</p>\n\n<ul>\n  <li lang=\"en\"><strong>Data agents:</strong> Cost estimation and optimization for data agents.</li>\n  <li lang=\"zh\"><strong>数据智能体：</strong>数据智能体的代价估算与优化。</li>\n  <li lang=\"en\"><strong>LLM-powered data processing:</strong> Data understanding of semantic data processing.</li>\n  <li lang=\"zh\"><strong>大模型驱动的数据处理：</strong>语义数据处理中的数据理解。</li>\n  <li lang=\"en\"><strong>RAG systems:</strong> Graph RAG prototype system, knob-tuning for RAGs.</li>\n  <li lang=\"zh\"><strong>RAG 系统：</strong>图 RAG 原型系统、RAG 参数调优。</li>\n  <li lang=\"en\"><strong>Graph data management:</strong>  Community search, densest subgraph discovery algorithms.</li>\n  <li lang=\"zh\"><strong>图数据管理：</strong>社区搜索、最密子图发现算法。</li>\n</ul>\n","structuredPatch":[{"oldStart":7,"oldLines":28,"newStart":7,"newLines":45,"lines":["   - /about.html"," ---"," ","-I'm a junior undergraduate at The Chinese University of Hong Kong, Shenzhen, double majoring in *Computer Science and Engineering* and *Interdisciplinary Data Analytics*.","+<p lang=\"en\">I'm a junior undergraduate at The Chinese University of Hong Kong, Shenzhen, double majoring in <em>Computer Science and Engineering</em> and <em>Interdisciplinary Data Analytics</em>.</p>","+<p lang=\"zh\">我是香港中文大学（深圳）大三本科生，双主修<em>计算机科学与工程</em>与<em>跨学科数据分析</em>。</p>"," ","-My research interests mainly lie in **Data agents** and **LLM-powered data processing**. One set of questions I have been thinking about is how to build agentic data systems for hard data tasks, particularly: (1) what roles agents could play in solving data tasks and as components of database systems; (2) how agents should interact with databases, and how to build agent-friendly data environments; and (3) how to make data agents and agentic data systems work efficiently and reliably.","-Prior to this, I also had rich experience in **Graph data management**.","+<p lang=\"en\">My research interests mainly lie in <strong>Data agents</strong> and <strong>LLM-powered data processing</strong>. One set of questions I have been thinking about is how to build agentic data systems for hard data tasks, particularly: (1) what roles agents could play in solving data tasks and as components of database systems; (2) how agents should interact with databases, and how to build agent-friendly data environments; and (3) how to make data agents and agentic data systems work efficiently and reliably.","+Prior to this, I also had rich experience in <strong>Graph data management</strong>.</p>","+<p lang=\"zh\">我的研究兴趣主要集中在<strong>数据智能体</strong>和<strong>大语言模型驱动的数据处理</strong>。我一直思考的核心问题是：如何为复杂数据任务构建智能体数据系统，具体包括：（1）智能体在求解数据任务及作为数据库系统组件时能扮演什么角色；（2）智能体应如何与数据库交互，以及如何构建对智能体友好的数据环境；（3）如何使数据智能体及智能体数据系统高效、可靠地运行。此前，我在<strong>图数据管理</strong>领域也积累了丰富的研究经验。</p>"," ","-> I am now actively seeking a PhD position for Fall 2027!","+<blockquote lang=\"en\">I am now actively seeking a PhD position for Fall 2027!</blockquote>","+<blockquote lang=\"zh\">我正在积极寻求 2027 年秋季入学的博士项目！</blockquote>"," ","-Experience","-======","+<h2 id=\"experience\"><span lang=\"en\">Experience</span><span lang=\"zh\">经历</span></h2>"," ","-I'm in the first cohort of CUHK's <a href=\"https://www.idadm.cdmp.cuhk.edu.hk/\">IDADM</a> programme, which offered an collaborated double major bachelor education across both Hong Kong and Shenzhen campuses of CUHK, two years at each site.","+<p lang=\"en\">I'm in the first cohort of CUHK's <a href=\"https://www.idadm.cdmp.cuhk.edu.hk/\">IDADM</a> programme, which offered a collaborated double major bachelor education across both Hong Kong and Shenzhen campuses of CUHK, two years at each site.</p>","+<p lang=\"zh\">我是港中大 <a href=\"https://www.idadm.cdmp.cuhk.edu.hk/\">IDADM</a> 项目的首届学生。该项目提供香港与深圳两个校区联合培养的双学士学位教育，各驻校两年。</p>"," ","-During my college study, I have been consistently studying various topics about databases at these places:","+<p lang=\"en\">During my college study, I have been consistently studying various topics about databases at these places:</p>","+<p lang=\"zh\">大学期间，我持续在以下机构深耕数据库相关方向的研究：</p>"," ","-* (2026.5 - now) I'm having a research intern in **Tsinghua University** Database Group, supervised by **[Prof. Guoliang Li](https://dbgroup.cs.tsinghua.edu.cn/ligl/)** and [Prof. Ji Sun](https://sunji.greatji.com/).","-* (2026.1 - 2026.5) I visited **UC Berkeley**, where I had the privilege of being supervised by **[Prof. Aditya Parameswaran](https://people.eecs.berkeley.edu/~adityagp/)** and gained a both enjoyable and rewarding collaboration with [Dr. Sepanta Zeighami](https://szeighami.github.io/) in the [EPIC Data lab](https://epic.berkeley.edu/).","-* (2024.1 - 2025.12) At **CUHK-Shenzhen**, I was supervised by **[Prof. Yixiang Fang](https://fangyixiang.github.io/)** and had the pleasure working closely with [Dr. Yingli Zhou](https://jaylzhou.github.io/), where I was first introduced to academic research and databases.","+<ul>","+  <li lang=\"en\">(2026.5 - now) I'm having a research intern in <strong>Tsinghua University</strong> Database Group, supervised by <strong><a href=\"https://dbgroup.cs.tsinghua.edu.cn/ligl/\">Prof. Guoliang Li</a></strong> and <a href=\"https://sunji.greatji.com/\">Prof. Ji Sun</a>.</li>","+  <li lang=\"zh\">（2026.5 至今）我正在<strong>清华大学</strong>数据库研究组实习，导师为<strong><a href=\"https://dbgroup.cs.tsinghua.edu.cn/ligl/\">李国良教授</a></strong>和<a href=\"https://sunji.greatji.com/\">孙冀教授</a>。</li>","+  <li lang=\"en\">(2026.1 - 2026.5) I visited <strong>UC Berkeley</strong>, where I had the privilege of being supervised by <strong><a href=\"https://people.eecs.berkeley.edu/~adityagp/\">Prof. Aditya Parameswaran</a></strong> and gained a both enjoyable and rewarding collaboration with <a href=\"https://szeighami.github.io/\">Dr. Sepanta Zeighami</a> in the <a href=\"https://epic.berkeley.edu/\">EPIC Data lab</a>.</li>","+  <li lang=\"zh\">（2026.1 — 2026.5）我访问了<strong>加州大学伯克利分校</strong>，有幸师从<strong><a href=\"https://people.eecs.berkeley.edu/~adityagp/\">Aditya Parameswaran 教授</a></strong>，并在 <a href=\"https://epic.berkeley.edu/\">EPIC Data 实验室</a>与<a href=\"https://szeighami.github.io/\">Sepanta Zeighami 博士</a>开展了愉快而富有成效的合作研究。</li>","+  <li lang=\"en\">(2024.1 - 2025.12) At <strong>CUHK-Shenzhen</strong>, I was supervised by <strong><a href=\"https://fangyixiang.github.io/\">Prof. Yixiang Fang</a></strong> and had the pleasure working closely with <a href=\"https://jaylzhou.github.io/\">Dr. Yingli Zhou</a>, where I was first introduced to academic research and databases.</li>","+  <li lang=\"zh\">（2024.1 — 2025.12）在<strong>港中大（深圳）</strong>，我师从<strong><a href=\"https://fangyixiang.github.io/\">方怡翔教授</a></strong>，并有幸与<a href=\"https://jaylzhou.github.io/\">周颖丽博士</a>紧密合作，在这里我初次接触到学术研究与数据库领域。</li>","+</ul>"," ","-Interests","-======","-I've been participating in research projects on the following topics:","-* **Data agents:** Cost estimation and optimization for data agents.","-* **LLM-powered data processing:** Data understanding of semantic data processing.","-* **RAG systems:** Graph RAG prototype system, knob-tuning for RAGs.","-* **Graph data management:**  Community search, densest subgraph discovery algorithms.","\\ No newline at end of file","+<h2 id=\"interests\"><span lang=\"en\">Interests</span><span lang=\"zh\">研究方向</span></h2>","+","+<p lang=\"en\">I've been participating in research projects on the following topics:</p>","+<p lang=\"zh\">我参与过以下方向的研究项目：</p>","+","+<ul>","+  <li lang=\"en\"><strong>Data agents:</strong> Cost estimation and optimization for data agents.</li>","+  <li lang=\"zh\"><strong>数据智能体：</strong>数据智能体的代价估算与优化。</li>","+  <li lang=\"en\"><strong>LLM-powered data processing:</strong> Data understanding of semantic data processing.</li>","+  <li lang=\"zh\"><strong>大模型驱动的数据处理：</strong>语义数据处理中的数据理解。</li>","+  <li lang=\"en\"><strong>RAG systems:</strong> Graph RAG prototype system, knob-tuning for RAGs.</li>","+  <li lang=\"zh\"><strong>RAG 系统：</strong>图 RAG 原型系统、RAG 参数调优。</li>","+  <li lang=\"en\"><strong>Graph data management:</strong>  Community search, densest subgraph discovery algorithms.</li>","+  <li lang=\"zh\"><strong>图数据管理：</strong>社区搜索、最密子图发现算法。</li>","+</ul>"]}],"originalFile":"---\npermalink: /\ntitle: \"Youran Sun 孙悠然\"\nauthor_profile: true\nredirect_from: \n  - /about/\n  - /about.html\n---\n\nI'm a junior undergraduate at The Chinese University of Hong Kong, Shenzhen, double majoring in *Computer Science and Engineering* and *Interdisciplinary Data Analytics*.\n\nMy research interests mainly lie in **Data agents** and **LLM-powered data processing**. One set of questions I have been thinking about is how to build agentic data systems for hard data tasks, particularly: (1) what roles agents could play in solving data tasks and as components of database systems; (2) how agents should interact with databases, and how to build agent-friendly data environments; and (3) how to make data agents and agentic data systems work efficiently and reliably.\nPrior to this, I also had rich experience in **Graph data management**.\n\n> I am now actively seeking a PhD position for Fall 2027!\n\nExperience\n======\n\nI'm in the first cohort of CUHK's <a href=\"https://www.idadm.cdmp.cuhk.edu.hk/\">IDADM</a> programme, which offered an collaborated double major bachelor education across both Hong Kong and Shenzhen campuses of CUHK, two years at each site.\n\nDuring my college study, I have been consistently studying various topics about databases at these places:\n\n* (2026.5 - now) I'm having a research intern in **Tsinghua University** Database Group, supervised by **[Prof. Guoliang Li](https://dbgroup.cs.tsinghua.edu.cn/ligl/)** and [Prof. Ji Sun](https://sunji.greatji.com/).\n* (2026.1 - 2026.5) I visited **UC Berkeley**, where I had the privilege of being supervised by **[Prof. Aditya Parameswaran](https://people.eecs.berkeley.edu/~adityagp/)** and gained a both enjoyable and rewarding collaboration with [Dr. Sepanta Zeighami](https://szeighami.github.io/) in the [EPIC Data lab](https://epic.berkeley.edu/).\n* (2024.1 - 2025.12) At **CUHK-Shenzhen**, I was supervised by **[Prof. Yixiang Fang](https://fangyixiang.github.io/)** and had the pleasure working closely with [Dr. Yingli Zhou](https://jaylzhou.github.io/), where I was first introduced to academic research and databases.\n\nInterests\n======\nI've been participating in research projects on the following topics:\n* **Data agents:** Cost estimation and optimization for data agents.\n* **LLM-powered data processing:** Data understanding of semantic data processing.\n* **RAG systems:** Graph RAG prototype system, knob-tuning for RAGs.\n* **Graph data management:**  Community search, densest subgraph discovery algorithms.","userModified":false},"tool_use_id":"toolu_01Q8wfoHG6LoBhDQ6fQ22wqj","duration_ms":149,"logged_at":"2026-06-17T23:23:22"}
{"session_id":"b606e9ca-b863-4906-850e-562afca2707c","transcript_path":"/home/youran/.claude/projects/-mnt-d-research-YouranSun-github-io/b606e9ca-b863-4906-850e-562afca2707c.jsonl","cwd":"/mnt/d/research/YouranSun.github.io","permission_mode":"bypassPermissions","effort":{"level":"high"},"hook_event_name":"PreToolUse","tool_name":"Write","tool_input":{"file_path":"/mnt/d/research/YouranSun.github.io/_pages/competitive-programming.md","content":"---\ntitle: \"Competitive Programming\"\npermalink: /competitive-programming/\nauthor_profile: true\n---\n\n<p lang=\"en\">I have been participating competitive programming since junior high school, attending the <strong>Olympiad in Informatics (OI)</strong> in high school as well as the <strong>International/China Collegiate Programming Contest (ICPC/CCPC)</strong> in college.</p>\n<p lang=\"zh\">我从初中起便参与算法竞赛，高中参加<strong>信息学奥林匹克（OI）</strong>，大学参加<strong>国际/中国大学生程序设计竞赛（ICPC/CCPC）</strong>。</p>\n\n<p lang=\"en\">At CUHK-Shenzhen, I served as the <strong>student leader</strong> of the university's 30-member competitive programming team from Jun 2024 to Dec 2025, coached by <a href=\"https://fangyixiang.github.io/\">Prof. Yixiang Fang</a> and <a href=\"https://chenhao-ma.github.io/\">Prof. Chenhao Ma</a>, with additional advice from <a href=\"http://chenjb1997.github.io/\">Prof. Jingbang Chen</a>. During this time, besides contest participation, we continuously provided related resources to the broader university community.</p>\n<p lang=\"zh\">在港中大（深圳），我担任校算法竞赛队<strong>学生队长</strong>（2024 年 6 月至 2025 年 12 月），队伍约 30 人，由<a href=\"https://fangyixiang.github.io/\">方怡翔教授</a>和<a href=\"https://chenhao-ma.github.io/\">马陈豪教授</a>指导，<a href=\"http://chenjb1997.github.io/\">陈敬邦教授</a>亦提供了宝贵建议。任职期间，除参加比赛外，我们还持续为校内更广泛的学生群体提供相关资源与支持。</p>\n\n<div style=\"display: flex; gap: 10px;\">\n  <figure style=\"width: 29.45%; text-align: center;\">\n    <img src=\"{{ '/images/CCPC-girls.jpg' | relative_url }}\" style=\"width: 100%;\">\n    <figcaption>\n      <span lang=\"en\">Winning CCPC Girls' Division, placing 1st nationwide, together with Xiaoxiao and Jiuzhi.</span>\n      <span lang=\"zh\">与小小、九之共同荣获 CCPC 女生专场全国冠军。</span>\n    </figcaption>\n  </figure>\n\n  <figure style=\"width: 33.55%; text-align: center;\">\n    <img src=\"{{ '/images/GBAIPC.jpg' | relative_url }}\" style=\"width: 100%;\">\n    <figcaption>\n      <span lang=\"en\">Contributed to the organization of the 2025 Canton-Hong Kong-Macau Greater Bay Area Programming Contest, a part of <a href=\"https://www.slai.edu.cn/\">SLAI</a>'s first cohort admission.</span>\n      <span lang=\"zh\">参与组织 2025 年粤港澳大湾区程序设计竞赛，该赛事是<a href=\"https://www.slai.edu.cn/\">SLAI</a> 首届招生活动的一部分。</span>\n    </figcaption>\n  </figure>\n</div>\n\n<h2><span lang=\"en\">Selected Awards</span><span lang=\"zh\">竞赛成绩</span></h2>\n\n<p lang=\"en\"><strong>College</strong></p>\n<p lang=\"zh\"><strong>大学</strong></p>\n\n<ul>\n  <li lang=\"en\">🥇<strong>Champion</strong> (1st place) -- <a href=\"https://rl.algoux.org/ranklist/ccpc2025ladies\">The 11<sup>th</sup> CCPC Girls' Division</a>, Oct 2025</li>\n  <li lang=\"zh\">🥇<strong>冠军</strong>（第 1 名）——<a href=\"https://rl.algoux.org/ranklist/ccpc2025ladies\">第十一届 CCPC 女生专场</a>，2025 年 10 月</li>\n  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (26th place) -- <a href=\"https://board.xcpcio.com/icpc/49th/ecfinal?group=official\">The 49<sup>th</sup> ICPC Asia East Continent Final Contest</a>, Dec 2024</li>\n  <li lang=\"zh\">🏆<strong>金牌</strong>（第 26 名）——<a href=\"https://board.xcpcio.com/icpc/49th/ecfinal?group=official\">第四十九届 ICPC 亚洲区东亚大陆总决赛</a>，2024 年 12 月</li>\n  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (6th place) -- <a href=\"https://board.xcpcio.com/icpc/49th/hongkong?group=official\">The 49<sup>th</sup> ICPC Asia Hong Kong Regional Contest</a>, Dec 2024</li>\n  <li lang=\"zh\">🏆<strong>金牌</strong>（第 6 名）——<a href=\"https://board.xcpcio.com/icpc/49th/hongkong?group=official\">第四十九届 ICPC 亚洲区香港站</a>，2024 年 12 月</li>\n  <li lang=\"en\">🥉<strong>2nd Runner-up</strong> (3rd place) -- <a href=\"https://board.xcpcio.com/ccpc/10th/zhengzhou?group=official\">The 10<sup>th</sup> CCPC Zhengzhou site</a>, Nov 2024</li>\n  <li lang=\"zh\">🥉<strong>季军</strong>（第 3 名）——<a href=\"https://board.xcpcio.com/ccpc/10th/zhengzhou?group=official\">第十届 CCPC 郑州站</a>，2024 年 11 月</li>\n  <li lang=\"en\">🥈<strong>1st Runner-up</strong> (2nd place) -- <a href=\"https://rl.algoux.org/ranklist/ccpc2024ladies\">The 10<sup>th</sup> CCPC Girls' Division</a>, Nov 2024</li>\n  <li lang=\"zh\">🥈<strong>亚军</strong>（第 2 名）——<a href=\"https://rl.algoux.org/ranklist/ccpc2024ladies\">第十届 CCPC 女生专场</a>，2024 年 11 月</li>\n  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (16th place) -- <a href=\"https://board.xcpcio.com/icpc/49th/chengdu?group=official\">The 49<sup>th</sup> ICPC Asia Chengdu Regional Contest</a>, Oct 2024</li>\n  <li lang=\"zh\">🏆<strong>金牌</strong>（第 16 名）——<a href=\"https://board.xcpcio.com/icpc/49th/chengdu?group=official\">第四十九届 ICPC 亚洲区成都站</a>，2024 年 10 月</li>\n  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (19th place) -- <a href=\"https://board.xcpcio.com/ccpc/10th/harbin?group=official\">The 10<sup>th</sup> CCPC Harbin Site</a>, Oct 2024</li>\n  <li lang=\"zh\">🏆<strong>金牌</strong>（第 19 名）——<a href=\"https://board.xcpcio.com/ccpc/10th/harbin?group=official\">第十届 CCPC 哈尔滨站</a>，2024 年 10 月</li>\n  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (17th place) -- <a href=\"https://board.xcpcio.com/icpc/48th/nanjing?group=official\">The 48<sup>th</sup> ICPC Asia Nanjing Regional Contest</a>, Nov 2023</li>\n  <li lang=\"zh\">🏆<strong>金牌</strong>（第 17 名）——<a href=\"https://board.xcpcio.com/icpc/48th/nanjing?group=official\">第四十八届 ICPC 亚洲区南京站</a>，2023 年 11 月</li>\n</ul>\n\n<p lang=\"en\"><strong>High school</strong></p>\n<p lang=\"zh\"><strong>高中</strong></p>\n\n<ul>\n  <li lang=\"en\">🥉<strong>Bronze Medalist</strong> -- <a href=\"https://www.noi.cn/upload/resources/file/2024/06/03/75fa469e47f6785fcb88c3dc01a7ec81.htm\">National Olympiad in Informatics</a>, Aug 2022</li>\n  <li lang=\"zh\">🥉<strong>铜牌</strong>——<a href=\"https://www.noi.cn/upload/resources/file/2024/06/03/75fa469e47f6785fcb88c3dc01a7ec81.htm\">全国信息学奥林匹克联赛（NOI）</a>，2022 年 8 月</li>\n  <li lang=\"en\">🏆<strong>1st Prize</strong> (1st place) -- <a href=\"https://www.noi.cn/upload/resources/file/2022/05/07/202205070930.htm\">National Olympiad in Informatics, Girls' Contest</a>, May 2022</li>\n  <li lang=\"zh\">🏆<strong>一等奖</strong>（第 1 名）——<a href=\"https://www.noi.cn/upload/resources/file/2022/05/07/202205070930.htm\">全国信息学奥林匹克女生赛</a>，2022 年 5 月</li>\n  <li lang=\"en\">🥈<strong>Silver Medalist</strong> -- <a href=\"https://www.noi.cn/upload/resources/file/2021/08/23/165993.html\">National Olympiad in Informatics Summer Camp</a>, Jul 2021</li>\n  <li lang=\"zh\">🥈<strong>银牌</strong>——<a href=\"https://www.noi.cn/upload/resources/file/2021/08/23/165993.html\">全国信息学奥林匹克夏令营（NOI Summer Camp）</a>，2021 年 7 月</li>\n</ul>\n\n<h2><span lang=\"en\">Breaking Barriers</span><span lang=\"zh\">破除壁垒</span></h2>\n\n<p lang=\"en\">The team and I have been making consistent efforts to make competitive welcoming to everyone. The purpose of doing this, is to spread helpful knowledge (Yes, we believe many insights from competitive programming are very beneficial for undergraduate CS study) and provide a home for folks' interest in this field. We managed to overcome many difficulties, including:</p>\n<p lang=\"zh\">我和队伍一直致力于让算法竞赛对每个人都更加友好。我们的目的是传播有益的知识（我们坚信，竞赛编程中的许多思维方式对本科 CS 学习大有裨益），并为对这一领域感兴趣的同学提供归属感。我们克服了许多困难，包括：</p>\n\n<ul>\n  <li lang=\"en\"><strong>Gender exclusion:</strong> Women remain underrepresented in competitive programming contests, and I have worked to increase their participation at our university. Since 2023, 6 girls have joined our team, and 4 of them have become gold medalists in ICPC Asia Regional Contests. I also led teams to participate in the CCPC Girls' Division for three consecutive years (2023 -- 2025), helping establish it as a tradition at our university. In Fall 2025, we won <strong>1st place</strong> in <a href=\"https://rl.algoux.org/ranklist/ccpc2025ladies\">The 11<sup>th</sup> CCPC Girls' Division</a>, obtaining the first champion in this contest in our university's history (see <a href=\"https://mp.weixin.qq.com/s/FMxGKg2e8ZSot-qS9uJEfg\">WeChat post</a>).</li>\n  <li lang=\"zh\"><strong>性别壁垒：</strong>女性在算法竞赛中长期处于弱势地位。为此，我积极推动女生在校内的参赛。自 2023 年起，共有 6 名女生加入队伍，其中 4 人在 ICPC 亚洲区域赛中获得金牌。我连续三年（2023—2025）带队参加 CCPC 女生专场，推动其成为学校的固定传统。2025 年秋季，我们以<strong>全国第一</strong>的成绩赢得<a href=\"https://rl.algoux.org/ranklist/ccpc2025ladies\">第十一届 CCPC 女生专场</a>，这也是我校在该项目历史上的首个冠军（详见<a href=\"https://mp.weixin.qq.com/s/FMxGKg2e8ZSot-qS9uJEfg\">微信推文</a>）。</li>\n  <li lang=\"en\"><strong>Knowledge barriers:</strong> High-level awards in collegiate contests mostly go to students with prior high school OI experience (like me). To broaden access to beginners, I helped build a selection-and-training mechanism in our school. In 2024 fall, I formed a team where all members had <strong>zero CNOI experience</strong> and offered them <strong>hands-on guidance from scratch</strong>. They finally won a <strong>Gold Medal</strong> (31st place) in <a href=\"https://board.xcpcio.com/icpc/49th/chengdu?group=official\">The 49<sup>th</sup> ICPC Asia Chengdu Regional Contest</a>.</li>\n  <li lang=\"zh\"><strong>知识壁垒：</strong>大学联赛中的高奖项大多由具备高中 OI 经验的选手（如我）摘得。为降低入门门槛，我参与建立了学校的选拔与培训机制。2024 年秋季，我组建了一支成员<strong>均无 OI 经验</strong>的队伍，并为其提供<strong>从零开始的实操指导</strong>。他们最终在<a href=\"https://board.xcpcio.com/icpc/49th/chengdu?group=official\">第四十九届 ICPC 亚洲区成都站</a>荣获<strong>金牌</strong>（第 31 名）。</li>\n  <li lang=\"en\"><strong>Imbalanced training quality:</strong> Training quality for OI in high schools depends heavily their tiers and resources. Our team provided <strong>weekend lectures</strong> for CUHK-Shenzhen affiliated middle/high schools for OI training (I did a part of them). In 2025, their students achieved 13 prizes in CCF-CSP, with <strong>1 first prize in CSP-S for the first time</strong>, marking a significant breakthrough (see <a href=\"https://mp.weixin.qq.com/s/28O-Q5V5HUT9cAIeHFAHdg\">WeChat post</a>).</li>\n  <li lang=\"zh\"><strong>培训资源不均：</strong>高中 OI 的培训质量高度依赖学校的层次与资源。我们团队为港中大（深圳）附属中学提供<strong>周末讲座</strong>进行 OI 培训（我主讲了其中一部分）。2025 年，附校学生在 CCF-CSP 中共获 13 项奖项，其中<strong>首次斩获 CSP-S 一等奖</strong>，实现重大突破（详见<a href=\"https://mp.weixin.qq.com/s/28O-Q5V5HUT9cAIeHFAHdg\">微信推文</a>）。</li>\n</ul>\n\n<p lang=\"en\">The team has also been doing other services, including:</p>\n<p lang=\"zh\">队伍还提供了以下其他服务：</p>\n\n<ul>\n  <li lang=\"en\"><strong>Voluntary final review lectures</strong> for the following courses on programming, algorithms, discrete math, data structures, and database systems: CSC1001, CSC1003, CSC3001, CSC3100, and CSC3170. I did the overall organization for these events in 2024 and 2025. (WeChat posts for <a href=\"https://mp.weixin.qq.com/s/ZPVC79dJH5Pw2-A8m0DJ6A\">2025</a>, <a href=\"https://mp.weixin.qq.com/s/17ouE0bikE4DW-8abUU3fw\">2024</a>)</li>\n  <li lang=\"zh\"><strong>自愿期末复习讲座</strong>，覆盖程序设计、算法、离散数学、数据结构与数据库系统等课程（CSC1001、CSC1003、CSC3001、CSC3100、CSC3170）。我在 2024 年和 2025 年总负责了这些活动的统筹组织。（微信推文：<a href=\"https://mp.weixin.qq.com/s/ZPVC79dJH5Pw2-A8m0DJ6A\">2025 年</a>、<a href=\"https://mp.weixin.qq.com/s/17ouE0bikE4DW-8abUU3fw\">2024 年</a>）</li>\n  <li lang=\"en\"><strong>CUHK-Shenzhen's annual competitive programming contests.</strong> We welcome college and high school students nationwide to attend our contests and set two division for experienced and unexperienced participants. 300~500 students join our contest every year. I deeply participated the contest organization and execution in 2024, and served as the leading student organizer in 2025. Supported by these successful experiences, we held the ICPC China Shenzhen Invitational in 2026. (WeChat posts for <a href=\"https://mp.weixin.qq.com/s/TYJgMVE0ewP-qykDglk6Ig\">2025</a>, <a href=\"https://mp.weixin.qq.com/s/HO15ApkFF3ACXIo66RgKEw\">2024</a>)</li>\n  <li lang=\"zh\"><strong>港中大（深圳）年度算法竞赛。</strong>我们面向全国高校及高中生举办比赛，设有新手组与经验组。每年有 300～500 名学生参赛。我在 2024 年深度参与了赛事的组织与执行，并在 2025 年担任学生主要负责人。基于这些成功经验，我们于 2026 年承办了 ICPC 中国深圳邀请赛。（微信推文：<a href=\"https://mp.weixin.qq.com/s/TYJgMVE0ewP-qykDglk6Ig\">2025 年</a>、<a href=\"https://mp.weixin.qq.com/s/HO15ApkFF3ACXIo66RgKEw\">2024 年</a>）</li>\n</ul>\n"},"tool_use_id":"toolu_01NhX8dmqHJvuGEJYHa3nw24","logged_at":"2026-06-17T23:24:47"}
{"session_id":"b606e9ca-b863-4906-850e-562afca2707c","transcript_path":"/home/youran/.claude/projects/-mnt-d-research-YouranSun-github-io/b606e9ca-b863-4906-850e-562afca2707c.jsonl","cwd":"/mnt/d/research/YouranSun.github.io","permission_mode":"bypassPermissions","effort":{"level":"high"},"hook_event_name":"PostToolUse","tool_name":"Write","tool_input":{"file_path":"/mnt/d/research/YouranSun.github.io/_pages/competitive-programming.md","content":"---\ntitle: \"Competitive Programming\"\npermalink: /competitive-programming/\nauthor_profile: true\n---\n\n<p lang=\"en\">I have been participating competitive programming since junior high school, attending the <strong>Olympiad in Informatics (OI)</strong> in high school as well as the <strong>International/China Collegiate Programming Contest (ICPC/CCPC)</strong> in college.</p>\n<p lang=\"zh\">我从初中起便参与算法竞赛，高中参加<strong>信息学奥林匹克（OI）</strong>，大学参加<strong>国际/中国大学生程序设计竞赛（ICPC/CCPC）</strong>。</p>\n\n<p lang=\"en\">At CUHK-Shenzhen, I served as the <strong>student leader</strong> of the university's 30-member competitive programming team from Jun 2024 to Dec 2025, coached by <a href=\"https://fangyixiang.github.io/\">Prof. Yixiang Fang</a> and <a href=\"https://chenhao-ma.github.io/\">Prof. Chenhao Ma</a>, with additional advice from <a href=\"http://chenjb1997.github.io/\">Prof. Jingbang Chen</a>. During this time, besides contest participation, we continuously provided related resources to the broader university community.</p>\n<p lang=\"zh\">在港中大（深圳），我担任校算法竞赛队<strong>学生队长</strong>（2024 年 6 月至 2025 年 12 月），队伍约 30 人，由<a href=\"https://fangyixiang.github.io/\">方怡翔教授</a>和<a href=\"https://chenhao-ma.github.io/\">马陈豪教授</a>指导，<a href=\"http://chenjb1997.github.io/\">陈敬邦教授</a>亦提供了宝贵建议。任职期间，除参加比赛外，我们还持续为校内更广泛的学生群体提供相关资源与支持。</p>\n\n<div style=\"display: flex; gap: 10px;\">\n  <figure style=\"width: 29.45%; text-align: center;\">\n    <img src=\"{{ '/images/CCPC-girls.jpg' | relative_url }}\" style=\"width: 100%;\">\n    <figcaption>\n      <span lang=\"en\">Winning CCPC Girls' Division, placing 1st nationwide, together with Xiaoxiao and Jiuzhi.</span>\n      <span lang=\"zh\">与小小、九之共同荣获 CCPC 女生专场全国冠军。</span>\n    </figcaption>\n  </figure>\n\n  <figure style=\"width: 33.55%; text-align: center;\">\n    <img src=\"{{ '/images/GBAIPC.jpg' | relative_url }}\" style=\"width: 100%;\">\n    <figcaption>\n      <span lang=\"en\">Contributed to the organization of the 2025 Canton-Hong Kong-Macau Greater Bay Area Programming Contest, a part of <a href=\"https://www.slai.edu.cn/\">SLAI</a>'s first cohort admission.</span>\n      <span lang=\"zh\">参与组织 2025 年粤港澳大湾区程序设计竞赛，该赛事是<a href=\"https://www.slai.edu.cn/\">SLAI</a> 首届招生活动的一部分。</span>\n    </figcaption>\n  </figure>\n</div>\n\n<h2><span lang=\"en\">Selected Awards</span><span lang=\"zh\">竞赛成绩</span></h2>\n\n<p lang=\"en\"><strong>College</strong></p>\n<p lang=\"zh\"><strong>大学</strong></p>\n\n<ul>\n  <li lang=\"en\">🥇<strong>Champion</strong> (1st place) -- <a href=\"https://rl.algoux.org/ranklist/ccpc2025ladies\">The 11<sup>th</sup> CCPC Girls' Division</a>, Oct 2025</li>\n  <li lang=\"zh\">🥇<strong>冠军</strong>（第 1 名）——<a href=\"https://rl.algoux.org/ranklist/ccpc2025ladies\">第十一届 CCPC 女生专场</a>，2025 年 10 月</li>\n  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (26th place) -- <a href=\"https://board.xcpcio.com/icpc/49th/ecfinal?group=official\">The 49<sup>th</sup> ICPC Asia East Continent Final Contest</a>, Dec 2024</li>\n  <li lang=\"zh\">🏆<strong>金牌</strong>（第 26 名）——<a href=\"https://board.xcpcio.com/icpc/49th/ecfinal?group=official\">第四十九届 ICPC 亚洲区东亚大陆总决赛</a>，2024 年 12 月</li>\n  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (6th place) -- <a href=\"https://board.xcpcio.com/icpc/49th/hongkong?group=official\">The 49<sup>th</sup> ICPC Asia Hong Kong Regional Contest</a>, Dec 2024</li>\n  <li lang=\"zh\">🏆<strong>金牌</strong>（第 6 名）——<a href=\"https://board.xcpcio.com/icpc/49th/hongkong?group=official\">第四十九届 ICPC 亚洲区香港站</a>，2024 年 12 月</li>\n  <li lang=\"en\">🥉<strong>2nd Runner-up</strong> (3rd place) -- <a href=\"https://board.xcpcio.com/ccpc/10th/zhengzhou?group=official\">The 10<sup>th</sup> CCPC Zhengzhou site</a>, Nov 2024</li>\n  <li lang=\"zh\">🥉<strong>季军</strong>（第 3 名）——<a href=\"https://board.xcpcio.com/ccpc/10th/zhengzhou?group=official\">第十届 CCPC 郑州站</a>，2024 年 11 月</li>\n  <li lang=\"en\">🥈<strong>1st Runner-up</strong> (2nd place) -- <a href=\"https://rl.algoux.org/ranklist/ccpc2024ladies\">The 10<sup>th</sup> CCPC Girls' Division</a>, Nov 2024</li>\n  <li lang=\"zh\">🥈<strong>亚军</strong>（第 2 名）——<a href=\"https://rl.algoux.org/ranklist/ccpc2024ladies\">第十届 CCPC 女生专场</a>，2024 年 11 月</li>\n  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (16th place) -- <a href=\"https://board.xcpcio.com/icpc/49th/chengdu?group=official\">The 49<sup>th</sup> ICPC Asia Chengdu Regional Contest</a>, Oct 2024</li>\n  <li lang=\"zh\">🏆<strong>金牌</strong>（第 16 名）——<a href=\"https://board.xcpcio.com/icpc/49th/chengdu?group=official\">第四十九届 ICPC 亚洲区成都站</a>，2024 年 10 月</li>\n  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (19th place) -- <a href=\"https://board.xcpcio.com/ccpc/10th/harbin?group=official\">The 10<sup>th</sup> CCPC Harbin Site</a>, Oct 2024</li>\n  <li lang=\"zh\">🏆<strong>金牌</strong>（第 19 名）——<a href=\"https://board.xcpcio.com/ccpc/10th/harbin?group=official\">第十届 CCPC 哈尔滨站</a>，2024 年 10 月</li>\n  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (17th place) -- <a href=\"https://board.xcpcio.com/icpc/48th/nanjing?group=official\">The 48<sup>th</sup> ICPC Asia Nanjing Regional Contest</a>, Nov 2023</li>\n  <li lang=\"zh\">🏆<strong>金牌</strong>（第 17 名）——<a href=\"https://board.xcpcio.com/icpc/48th/nanjing?group=official\">第四十八届 ICPC 亚洲区南京站</a>，2023 年 11 月</li>\n</ul>\n\n<p lang=\"en\"><strong>High school</strong></p>\n<p lang=\"zh\"><strong>高中</strong></p>\n\n<ul>\n  <li lang=\"en\">🥉<strong>Bronze Medalist</strong> -- <a href=\"https://www.noi.cn/upload/resources/file/2024/06/03/75fa469e47f6785fcb88c3dc01a7ec81.htm\">National Olympiad in Informatics</a>, Aug 2022</li>\n  <li lang=\"zh\">🥉<strong>铜牌</strong>——<a href=\"https://www.noi.cn/upload/resources/file/2024/06/03/75fa469e47f6785fcb88c3dc01a7ec81.htm\">全国信息学奥林匹克联赛（NOI）</a>，2022 年 8 月</li>\n  <li lang=\"en\">🏆<strong>1st Prize</strong> (1st place) -- <a href=\"https://www.noi.cn/upload/resources/file/2022/05/07/202205070930.htm\">National Olympiad in Informatics, Girls' Contest</a>, May 2022</li>\n  <li lang=\"zh\">🏆<strong>一等奖</strong>（第 1 名）——<a href=\"https://www.noi.cn/upload/resources/file/2022/05/07/202205070930.htm\">全国信息学奥林匹克女生赛</a>，2022 年 5 月</li>\n  <li lang=\"en\">🥈<strong>Silver Medalist</strong> -- <a href=\"https://www.noi.cn/upload/resources/file/2021/08/23/165993.html\">National Olympiad in Informatics Summer Camp</a>, Jul 2021</li>\n  <li lang=\"zh\">🥈<strong>银牌</strong>——<a href=\"https://www.noi.cn/upload/resources/file/2021/08/23/165993.html\">全国信息学奥林匹克夏令营（NOI Summer Camp）</a>，2021 年 7 月</li>\n</ul>\n\n<h2><span lang=\"en\">Breaking Barriers</span><span lang=\"zh\">破除壁垒</span></h2>\n\n<p lang=\"en\">The team and I have been making consistent efforts to make competitive welcoming to everyone. The purpose of doing this, is to spread helpful knowledge (Yes, we believe many insights from competitive programming are very beneficial for undergraduate CS study) and provide a home for folks' interest in this field. We managed to overcome many difficulties, including:</p>\n<p lang=\"zh\">我和队伍一直致力于让算法竞赛对每个人都更加友好。我们的目的是传播有益的知识（我们坚信，竞赛编程中的许多思维方式对本科 CS 学习大有裨益），并为对这一领域感兴趣的同学提供归属感。我们克服了许多困难，包括：</p>\n\n<ul>\n  <li lang=\"en\"><strong>Gender exclusion:</strong> Women remain underrepresented in competitive programming contests, and I have worked to increase their participation at our university. Since 2023, 6 girls have joined our team, and 4 of them have become gold medalists in ICPC Asia Regional Contests. I also led teams to participate in the CCPC Girls' Division for three consecutive years (2023 -- 2025), helping establish it as a tradition at our university. In Fall 2025, we won <strong>1st place</strong> in <a href=\"https://rl.algoux.org/ranklist/ccpc2025ladies\">The 11<sup>th</sup> CCPC Girls' Division</a>, obtaining the first champion in this contest in our university's history (see <a href=\"https://mp.weixin.qq.com/s/FMxGKg2e8ZSot-qS9uJEfg\">WeChat post</a>).</li>\n  <li lang=\"zh\"><strong>性别壁垒：</strong>女性在算法竞赛中长期处于弱势地位。为此，我积极推动女生在校内的参赛。自 2023 年起，共有 6 名女生加入队伍，其中 4 人在 ICPC 亚洲区域赛中获得金牌。我连续三年（2023—2025）带队参加 CCPC 女生专场，推动其成为学校的固定传统。2025 年秋季，我们以<strong>全国第一</strong>的成绩赢得<a href=\"https://rl.algoux.org/ranklist/ccpc2025ladies\">第十一届 CCPC 女生专场</a>，这也是我校在该项目历史上的首个冠军（详见<a href=\"https://mp.weixin.qq.com/s/FMxGKg2e8ZSot-qS9uJEfg\">微信推文</a>）。</li>\n  <li lang=\"en\"><strong>Knowledge barriers:</strong> High-level awards in collegiate contests mostly go to students with prior high school OI experience (like me). To broaden access to beginners, I helped build a selection-and-training mechanism in our school. In 2024 fall, I formed a team where all members had <strong>zero CNOI experience</strong> and offered them <strong>hands-on guidance from scratch</strong>. They finally won a <strong>Gold Medal</strong> (31st place) in <a href=\"https://board.xcpcio.com/icpc/49th/chengdu?group=official\">The 49<sup>th</sup> ICPC Asia Chengdu Regional Contest</a>.</li>\n  <li lang=\"zh\"><strong>知识壁垒：</strong>大学联赛中的高奖项大多由具备高中 OI 经验的选手（如我）摘得。为降低入门门槛，我参与建立了学校的选拔与培训机制。2024 年秋季，我组建了一支成员<strong>均无 OI 经验</strong>的队伍，并为其提供<strong>从零开始的实操指导</strong>。他们最终在<a href=\"https://board.xcpcio.com/icpc/49th/chengdu?group=official\">第四十九届 ICPC 亚洲区成都站</a>荣获<strong>金牌</strong>（第 31 名）。</li>\n  <li lang=\"en\"><strong>Imbalanced training quality:</strong> Training quality for OI in high schools depends heavily their tiers and resources. Our team provided <strong>weekend lectures</strong> for CUHK-Shenzhen affiliated middle/high schools for OI training (I did a part of them). In 2025, their students achieved 13 prizes in CCF-CSP, with <strong>1 first prize in CSP-S for the first time</strong>, marking a significant breakthrough (see <a href=\"https://mp.weixin.qq.com/s/28O-Q5V5HUT9cAIeHFAHdg\">WeChat post</a>).</li>\n  <li lang=\"zh\"><strong>培训资源不均：</strong>高中 OI 的培训质量高度依赖学校的层次与资源。我们团队为港中大（深圳）附属中学提供<strong>周末讲座</strong>进行 OI 培训（我主讲了其中一部分）。2025 年，附校学生在 CCF-CSP 中共获 13 项奖项，其中<strong>首次斩获 CSP-S 一等奖</strong>，实现重大突破（详见<a href=\"https://mp.weixin.qq.com/s/28O-Q5V5HUT9cAIeHFAHdg\">微信推文</a>）。</li>\n</ul>\n\n<p lang=\"en\">The team has also been doing other services, including:</p>\n<p lang=\"zh\">队伍还提供了以下其他服务：</p>\n\n<ul>\n  <li lang=\"en\"><strong>Voluntary final review lectures</strong> for the following courses on programming, algorithms, discrete math, data structures, and database systems: CSC1001, CSC1003, CSC3001, CSC3100, and CSC3170. I did the overall organization for these events in 2024 and 2025. (WeChat posts for <a href=\"https://mp.weixin.qq.com/s/ZPVC79dJH5Pw2-A8m0DJ6A\">2025</a>, <a href=\"https://mp.weixin.qq.com/s/17ouE0bikE4DW-8abUU3fw\">2024</a>)</li>\n  <li lang=\"zh\"><strong>自愿期末复习讲座</strong>，覆盖程序设计、算法、离散数学、数据结构与数据库系统等课程（CSC1001、CSC1003、CSC3001、CSC3100、CSC3170）。我在 2024 年和 2025 年总负责了这些活动的统筹组织。（微信推文：<a href=\"https://mp.weixin.qq.com/s/ZPVC79dJH5Pw2-A8m0DJ6A\">2025 年</a>、<a href=\"https://mp.weixin.qq.com/s/17ouE0bikE4DW-8abUU3fw\">2024 年</a>）</li>\n  <li lang=\"en\"><strong>CUHK-Shenzhen's annual competitive programming contests.</strong> We welcome college and high school students nationwide to attend our contests and set two division for experienced and unexperienced participants. 300~500 students join our contest every year. I deeply participated the contest organization and execution in 2024, and served as the leading student organizer in 2025. Supported by these successful experiences, we held the ICPC China Shenzhen Invitational in 2026. (WeChat posts for <a href=\"https://mp.weixin.qq.com/s/TYJgMVE0ewP-qykDglk6Ig\">2025</a>, <a href=\"https://mp.weixin.qq.com/s/HO15ApkFF3ACXIo66RgKEw\">2024</a>)</li>\n  <li lang=\"zh\"><strong>港中大（深圳）年度算法竞赛。</strong>我们面向全国高校及高中生举办比赛，设有新手组与经验组。每年有 300～500 名学生参赛。我在 2024 年深度参与了赛事的组织与执行，并在 2025 年担任学生主要负责人。基于这些成功经验，我们于 2026 年承办了 ICPC 中国深圳邀请赛。（微信推文：<a href=\"https://mp.weixin.qq.com/s/TYJgMVE0ewP-qykDglk6Ig\">2025 年</a>、<a href=\"https://mp.weixin.qq.com/s/HO15ApkFF3ACXIo66RgKEw\">2024 年</a>）</li>\n</ul>\n"},"tool_response":{"type":"update","filePath":"/mnt/d/research/YouranSun.github.io/_pages/competitive-programming.md","content":"---\ntitle: \"Competitive Programming\"\npermalink: /competitive-programming/\nauthor_profile: true\n---\n\n<p lang=\"en\">I have been participating competitive programming since junior high school, attending the <strong>Olympiad in Informatics (OI)</strong> in high school as well as the <strong>International/China Collegiate Programming Contest (ICPC/CCPC)</strong> in college.</p>\n<p lang=\"zh\">我从初中起便参与算法竞赛，高中参加<strong>信息学奥林匹克（OI）</strong>，大学参加<strong>国际/中国大学生程序设计竞赛（ICPC/CCPC）</strong>。</p>\n\n<p lang=\"en\">At CUHK-Shenzhen, I served as the <strong>student leader</strong> of the university's 30-member competitive programming team from Jun 2024 to Dec 2025, coached by <a href=\"https://fangyixiang.github.io/\">Prof. Yixiang Fang</a> and <a href=\"https://chenhao-ma.github.io/\">Prof. Chenhao Ma</a>, with additional advice from <a href=\"http://chenjb1997.github.io/\">Prof. Jingbang Chen</a>. During this time, besides contest participation, we continuously provided related resources to the broader university community.</p>\n<p lang=\"zh\">在港中大（深圳），我担任校算法竞赛队<strong>学生队长</strong>（2024 年 6 月至 2025 年 12 月），队伍约 30 人，由<a href=\"https://fangyixiang.github.io/\">方怡翔教授</a>和<a href=\"https://chenhao-ma.github.io/\">马陈豪教授</a>指导，<a href=\"http://chenjb1997.github.io/\">陈敬邦教授</a>亦提供了宝贵建议。任职期间，除参加比赛外，我们还持续为校内更广泛的学生群体提供相关资源与支持。</p>\n\n<div style=\"display: flex; gap: 10px;\">\n  <figure style=\"width: 29.45%; text-align: center;\">\n    <img src=\"{{ '/images/CCPC-girls.jpg' | relative_url }}\" style=\"width: 100%;\">\n    <figcaption>\n      <span lang=\"en\">Winning CCPC Girls' Division, placing 1st nationwide, together with Xiaoxiao and Jiuzhi.</span>\n      <span lang=\"zh\">与小小、九之共同荣获 CCPC 女生专场全国冠军。</span>\n    </figcaption>\n  </figure>\n\n  <figure style=\"width: 33.55%; text-align: center;\">\n    <img src=\"{{ '/images/GBAIPC.jpg' | relative_url }}\" style=\"width: 100%;\">\n    <figcaption>\n      <span lang=\"en\">Contributed to the organization of the 2025 Canton-Hong Kong-Macau Greater Bay Area Programming Contest, a part of <a href=\"https://www.slai.edu.cn/\">SLAI</a>'s first cohort admission.</span>\n      <span lang=\"zh\">参与组织 2025 年粤港澳大湾区程序设计竞赛，该赛事是<a href=\"https://www.slai.edu.cn/\">SLAI</a> 首届招生活动的一部分。</span>\n    </figcaption>\n  </figure>\n</div>\n\n<h2><span lang=\"en\">Selected Awards</span><span lang=\"zh\">竞赛成绩</span></h2>\n\n<p lang=\"en\"><strong>College</strong></p>\n<p lang=\"zh\"><strong>大学</strong></p>\n\n<ul>\n  <li lang=\"en\">🥇<strong>Champion</strong> (1st place) -- <a href=\"https://rl.algoux.org/ranklist/ccpc2025ladies\">The 11<sup>th</sup> CCPC Girls' Division</a>, Oct 2025</li>\n  <li lang=\"zh\">🥇<strong>冠军</strong>（第 1 名）——<a href=\"https://rl.algoux.org/ranklist/ccpc2025ladies\">第十一届 CCPC 女生专场</a>，2025 年 10 月</li>\n  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (26th place) -- <a href=\"https://board.xcpcio.com/icpc/49th/ecfinal?group=official\">The 49<sup>th</sup> ICPC Asia East Continent Final Contest</a>, Dec 2024</li>\n  <li lang=\"zh\">🏆<strong>金牌</strong>（第 26 名）——<a href=\"https://board.xcpcio.com/icpc/49th/ecfinal?group=official\">第四十九届 ICPC 亚洲区东亚大陆总决赛</a>，2024 年 12 月</li>\n  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (6th place) -- <a href=\"https://board.xcpcio.com/icpc/49th/hongkong?group=official\">The 49<sup>th</sup> ICPC Asia Hong Kong Regional Contest</a>, Dec 2024</li>\n  <li lang=\"zh\">🏆<strong>金牌</strong>（第 6 名）——<a href=\"https://board.xcpcio.com/icpc/49th/hongkong?group=official\">第四十九届 ICPC 亚洲区香港站</a>，2024 年 12 月</li>\n  <li lang=\"en\">🥉<strong>2nd Runner-up</strong> (3rd place) -- <a href=\"https://board.xcpcio.com/ccpc/10th/zhengzhou?group=official\">The 10<sup>th</sup> CCPC Zhengzhou site</a>, Nov 2024</li>\n  <li lang=\"zh\">🥉<strong>季军</strong>（第 3 名）——<a href=\"https://board.xcpcio.com/ccpc/10th/zhengzhou?group=official\">第十届 CCPC 郑州站</a>，2024 年 11 月</li>\n  <li lang=\"en\">🥈<strong>1st Runner-up</strong> (2nd place) -- <a href=\"https://rl.algoux.org/ranklist/ccpc2024ladies\">The 10<sup>th</sup> CCPC Girls' Division</a>, Nov 2024</li>\n  <li lang=\"zh\">🥈<strong>亚军</strong>（第 2 名）——<a href=\"https://rl.algoux.org/ranklist/ccpc2024ladies\">第十届 CCPC 女生专场</a>，2024 年 11 月</li>\n  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (16th place) -- <a href=\"https://board.xcpcio.com/icpc/49th/chengdu?group=official\">The 49<sup>th</sup> ICPC Asia Chengdu Regional Contest</a>, Oct 2024</li>\n  <li lang=\"zh\">🏆<strong>金牌</strong>（第 16 名）——<a href=\"https://board.xcpcio.com/icpc/49th/chengdu?group=official\">第四十九届 ICPC 亚洲区成都站</a>，2024 年 10 月</li>\n  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (19th place) -- <a href=\"https://board.xcpcio.com/ccpc/10th/harbin?group=official\">The 10<sup>th</sup> CCPC Harbin Site</a>, Oct 2024</li>\n  <li lang=\"zh\">🏆<strong>金牌</strong>（第 19 名）——<a href=\"https://board.xcpcio.com/ccpc/10th/harbin?group=official\">第十届 CCPC 哈尔滨站</a>，2024 年 10 月</li>\n  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (17th place) -- <a href=\"https://board.xcpcio.com/icpc/48th/nanjing?group=official\">The 48<sup>th</sup> ICPC Asia Nanjing Regional Contest</a>, Nov 2023</li>\n  <li lang=\"zh\">🏆<strong>金牌</strong>（第 17 名）——<a href=\"https://board.xcpcio.com/icpc/48th/nanjing?group=official\">第四十八届 ICPC 亚洲区南京站</a>，2023 年 11 月</li>\n</ul>\n\n<p lang=\"en\"><strong>High school</strong></p>\n<p lang=\"zh\"><strong>高中</strong></p>\n\n<ul>\n  <li lang=\"en\">🥉<strong>Bronze Medalist</strong> -- <a href=\"https://www.noi.cn/upload/resources/file/2024/06/03/75fa469e47f6785fcb88c3dc01a7ec81.htm\">National Olympiad in Informatics</a>, Aug 2022</li>\n  <li lang=\"zh\">🥉<strong>铜牌</strong>——<a href=\"https://www.noi.cn/upload/resources/file/2024/06/03/75fa469e47f6785fcb88c3dc01a7ec81.htm\">全国信息学奥林匹克联赛（NOI）</a>，2022 年 8 月</li>\n  <li lang=\"en\">🏆<strong>1st Prize</strong> (1st place) -- <a href=\"https://www.noi.cn/upload/resources/file/2022/05/07/202205070930.htm\">National Olympiad in Informatics, Girls' Contest</a>, May 2022</li>\n  <li lang=\"zh\">🏆<strong>一等奖</strong>（第 1 名）——<a href=\"https://www.noi.cn/upload/resources/file/2022/05/07/202205070930.htm\">全国信息学奥林匹克女生赛</a>，2022 年 5 月</li>\n  <li lang=\"en\">🥈<strong>Silver Medalist</strong> -- <a href=\"https://www.noi.cn/upload/resources/file/2021/08/23/165993.html\">National Olympiad in Informatics Summer Camp</a>, Jul 2021</li>\n  <li lang=\"zh\">🥈<strong>银牌</strong>——<a href=\"https://www.noi.cn/upload/resources/file/2021/08/23/165993.html\">全国信息学奥林匹克夏令营（NOI Summer Camp）</a>，2021 年 7 月</li>\n</ul>\n\n<h2><span lang=\"en\">Breaking Barriers</span><span lang=\"zh\">破除壁垒</span></h2>\n\n<p lang=\"en\">The team and I have been making consistent efforts to make competitive welcoming to everyone. The purpose of doing this, is to spread helpful knowledge (Yes, we believe many insights from competitive programming are very beneficial for undergraduate CS study) and provide a home for folks' interest in this field. We managed to overcome many difficulties, including:</p>\n<p lang=\"zh\">我和队伍一直致力于让算法竞赛对每个人都更加友好。我们的目的是传播有益的知识（我们坚信，竞赛编程中的许多思维方式对本科 CS 学习大有裨益），并为对这一领域感兴趣的同学提供归属感。我们克服了许多困难，包括：</p>\n\n<ul>\n  <li lang=\"en\"><strong>Gender exclusion:</strong> Women remain underrepresented in competitive programming contests, and I have worked to increase their participation at our university. Since 2023, 6 girls have joined our team, and 4 of them have become gold medalists in ICPC Asia Regional Contests. I also led teams to participate in the CCPC Girls' Division for three consecutive years (2023 -- 2025), helping establish it as a tradition at our university. In Fall 2025, we won <strong>1st place</strong> in <a href=\"https://rl.algoux.org/ranklist/ccpc2025ladies\">The 11<sup>th</sup> CCPC Girls' Division</a>, obtaining the first champion in this contest in our university's history (see <a href=\"https://mp.weixin.qq.com/s/FMxGKg2e8ZSot-qS9uJEfg\">WeChat post</a>).</li>\n  <li lang=\"zh\"><strong>性别壁垒：</strong>女性在算法竞赛中长期处于弱势地位。为此，我积极推动女生在校内的参赛。自 2023 年起，共有 6 名女生加入队伍，其中 4 人在 ICPC 亚洲区域赛中获得金牌。我连续三年（2023—2025）带队参加 CCPC 女生专场，推动其成为学校的固定传统。2025 年秋季，我们以<strong>全国第一</strong>的成绩赢得<a href=\"https://rl.algoux.org/ranklist/ccpc2025ladies\">第十一届 CCPC 女生专场</a>，这也是我校在该项目历史上的首个冠军（详见<a href=\"https://mp.weixin.qq.com/s/FMxGKg2e8ZSot-qS9uJEfg\">微信推文</a>）。</li>\n  <li lang=\"en\"><strong>Knowledge barriers:</strong> High-level awards in collegiate contests mostly go to students with prior high school OI experience (like me). To broaden access to beginners, I helped build a selection-and-training mechanism in our school. In 2024 fall, I formed a team where all members had <strong>zero CNOI experience</strong> and offered them <strong>hands-on guidance from scratch</strong>. They finally won a <strong>Gold Medal</strong> (31st place) in <a href=\"https://board.xcpcio.com/icpc/49th/chengdu?group=official\">The 49<sup>th</sup> ICPC Asia Chengdu Regional Contest</a>.</li>\n  <li lang=\"zh\"><strong>知识壁垒：</strong>大学联赛中的高奖项大多由具备高中 OI 经验的选手（如我）摘得。为降低入门门槛，我参与建立了学校的选拔与培训机制。2024 年秋季，我组建了一支成员<strong>均无 OI 经验</strong>的队伍，并为其提供<strong>从零开始的实操指导</strong>。他们最终在<a href=\"https://board.xcpcio.com/icpc/49th/chengdu?group=official\">第四十九届 ICPC 亚洲区成都站</a>荣获<strong>金牌</strong>（第 31 名）。</li>\n  <li lang=\"en\"><strong>Imbalanced training quality:</strong> Training quality for OI in high schools depends heavily their tiers and resources. Our team provided <strong>weekend lectures</strong> for CUHK-Shenzhen affiliated middle/high schools for OI training (I did a part of them). In 2025, their students achieved 13 prizes in CCF-CSP, with <strong>1 first prize in CSP-S for the first time</strong>, marking a significant breakthrough (see <a href=\"https://mp.weixin.qq.com/s/28O-Q5V5HUT9cAIeHFAHdg\">WeChat post</a>).</li>\n  <li lang=\"zh\"><strong>培训资源不均：</strong>高中 OI 的培训质量高度依赖学校的层次与资源。我们团队为港中大（深圳）附属中学提供<strong>周末讲座</strong>进行 OI 培训（我主讲了其中一部分）。2025 年，附校学生在 CCF-CSP 中共获 13 项奖项，其中<strong>首次斩获 CSP-S 一等奖</strong>，实现重大突破（详见<a href=\"https://mp.weixin.qq.com/s/28O-Q5V5HUT9cAIeHFAHdg\">微信推文</a>）。</li>\n</ul>\n\n<p lang=\"en\">The team has also been doing other services, including:</p>\n<p lang=\"zh\">队伍还提供了以下其他服务：</p>\n\n<ul>\n  <li lang=\"en\"><strong>Voluntary final review lectures</strong> for the following courses on programming, algorithms, discrete math, data structures, and database systems: CSC1001, CSC1003, CSC3001, CSC3100, and CSC3170. I did the overall organization for these events in 2024 and 2025. (WeChat posts for <a href=\"https://mp.weixin.qq.com/s/ZPVC79dJH5Pw2-A8m0DJ6A\">2025</a>, <a href=\"https://mp.weixin.qq.com/s/17ouE0bikE4DW-8abUU3fw\">2024</a>)</li>\n  <li lang=\"zh\"><strong>自愿期末复习讲座</strong>，覆盖程序设计、算法、离散数学、数据结构与数据库系统等课程（CSC1001、CSC1003、CSC3001、CSC3100、CSC3170）。我在 2024 年和 2025 年总负责了这些活动的统筹组织。（微信推文：<a href=\"https://mp.weixin.qq.com/s/ZPVC79dJH5Pw2-A8m0DJ6A\">2025 年</a>、<a href=\"https://mp.weixin.qq.com/s/17ouE0bikE4DW-8abUU3fw\">2024 年</a>）</li>\n  <li lang=\"en\"><strong>CUHK-Shenzhen's annual competitive programming contests.</strong> We welcome college and high school students nationwide to attend our contests and set two division for experienced and unexperienced participants. 300~500 students join our contest every year. I deeply participated the contest organization and execution in 2024, and served as the leading student organizer in 2025. Supported by these successful experiences, we held the ICPC China Shenzhen Invitational in 2026. (WeChat posts for <a href=\"https://mp.weixin.qq.com/s/TYJgMVE0ewP-qykDglk6Ig\">2025</a>, <a href=\"https://mp.weixin.qq.com/s/HO15ApkFF3ACXIo66RgKEw\">2024</a>)</li>\n  <li lang=\"zh\"><strong>港中大（深圳）年度算法竞赛。</strong>我们面向全国高校及高中生举办比赛，设有新手组与经验组。每年有 300～500 名学生参赛。我在 2024 年深度参与了赛事的组织与执行，并在 2025 年担任学生主要负责人。基于这些成功经验，我们于 2026 年承办了 ICPC 中国深圳邀请赛。（微信推文：<a href=\"https://mp.weixin.qq.com/s/TYJgMVE0ewP-qykDglk6Ig\">2025 年</a>、<a href=\"https://mp.weixin.qq.com/s/HO15ApkFF3ACXIo66RgKEw\">2024 年</a>）</li>\n</ul>\n","structuredPatch":[{"oldStart":4,"oldLines":47,"newStart":4,"newLines":86,"lines":[" author_profile: true"," ---"," ","-I have been participating competitive programming since junior high school, attending the **Olympiad in Informatics (OI)** in high school as well as the **International/China Collegiate Programming Contest (ICPC/CCPC)** in college.","+<p lang=\"en\">I have been participating competitive programming since junior high school, attending the <strong>Olympiad in Informatics (OI)</strong> in high school as well as the <strong>International/China Collegiate Programming Contest (ICPC/CCPC)</strong> in college.</p>","+<p lang=\"zh\">我从初中起便参与算法竞赛，高中参加<strong>信息学奥林匹克（OI）</strong>，大学参加<strong>国际/中国大学生程序设计竞赛（ICPC/CCPC）</strong>。</p>"," ","-At CUHK-Shenzhen, I served as the **student leader** of the university's 30-member competitive programming team from Jun 2024 to Dec 2025, coached by [Prof. Yixiang Fang](https://fangyixiang.github.io/) and [Prof. Chenhao Ma](https://chenhao-ma.github.io/), with additional advice from [Prof. Jingbang Chen](http://chenjb1997.github.io/). During this time, besides contest participation, we continuously provided related resources to the broader university community.","+<p lang=\"en\">At CUHK-Shenzhen, I served as the <strong>student leader</strong> of the university's 30-member competitive programming team from Jun 2024 to Dec 2025, coached by <a href=\"https://fangyixiang.github.io/\">Prof. Yixiang Fang</a> and <a href=\"https://chenhao-ma.github.io/\">Prof. Chenhao Ma</a>, with additional advice from <a href=\"http://chenjb1997.github.io/\">Prof. Jingbang Chen</a>. During this time, besides contest participation, we continuously provided related resources to the broader university community.</p>","+<p lang=\"zh\">在港中大（深圳），我担任校算法竞赛队<strong>学生队长</strong>（2024 年 6 月至 2025 年 12 月），队伍约 30 人，由<a href=\"https://fangyixiang.github.io/\">方怡翔教授</a>和<a href=\"https://chenhao-ma.github.io/\">马陈豪教授</a>指导，<a href=\"http://chenjb1997.github.io/\">陈敬邦教授</a>亦提供了宝贵建议。任职期间，除参加比赛外，我们还持续为校内更广泛的学生群体提供相关资源与支持。</p>"," "," <div style=\"display: flex; gap: 10px;\">","   <figure style=\"width: 29.45%; text-align: center;\">","     <img src=\"{{ '/images/CCPC-girls.jpg' | relative_url }}\" style=\"width: 100%;\">","-    <figcaption>Winning CCPC Girls' Division, placing 1st nationwide, together with Xiaoxiao and Jiuzhi.</figcaption>","+    <figcaption>","+      <span lang=\"en\">Winning CCPC Girls' Division, placing 1st nationwide, together with Xiaoxiao and Jiuzhi.</span>","+      <span lang=\"zh\">与小小、九之共同荣获 CCPC 女生专场全国冠军。</span>","+    </figcaption>","   </figure>"," ","   <figure style=\"width: 33.55%; text-align: center;\">","     <img src=\"{{ '/images/GBAIPC.jpg' | relative_url }}\" style=\"width: 100%;\">","-    <figcaption>Contributed to the organization of the 2025 Canton-Hong Kong-Macau Greater Bay Area Programming Contest, a part of <a href=\"https://www.slai.edu.cn/\">SLAI</a>'s first cohort admission.</figcaption>","+    <figcaption>","+      <span lang=\"en\">Contributed to the organization of the 2025 Canton-Hong Kong-Macau Greater Bay Area Programming Contest, a part of <a href=\"https://www.slai.edu.cn/\">SLAI</a>'s first cohort admission.</span>","+      <span lang=\"zh\">参与组织 2025 年粤港澳大湾区程序设计竞赛，该赛事是<a href=\"https://www.slai.edu.cn/\">SLAI</a> 首届招生活动的一部分。</span>","+    </figcaption>","   </figure>"," </div>"," ","-Selected Awards","-=====","-**College**","-* 🥇**Champion** (1st place) -- [The 11<sup>th</sup> CCPC Girls' Division](https://rl.algoux.org/ranklist/ccpc2025ladies), Oct 2025","-* 🏆**Gold Medalist** (26th place) -- [The 49<sup>th</sup> ICPC Asia East Continent Final Contest](https://board.xcpcio.com/icpc/49th/ecfinal?group=official), Dec 2024","-* 🏆**Gold Medalist** (6th place) -- [The 49<sup>th</sup> ICPC Asia Hong Kong Regional Contest](https://board.xcpcio.com/icpc/49th/hongkong?group=official), Dec 2024","-* 🥉**2nd Runner-up** (3rd place) -- [The 10<sup>th</sup> CCPC Zhengzhou site](https://board.xcpcio.com/ccpc/10th/zhengzhou?group=official), Nov 2024","-* 🥈**1st Runner-up** (2nd place) -- [The 10<sup>th</sup> CCPC Girls' Division](https://rl.algoux.org/ranklist/ccpc2024ladies), Nov 2024","-* 🏆**Gold Medalist** (16th place) -- [The 49<sup>th</sup> ICPC Asia Chengdu Regional Contest](https://board.xcpcio.com/icpc/49th/chengdu?group=official), Oct 2024","-* 🏆**Gold Medalist** (19th place) -- [The 10<sup>th</sup> CCPC Harbin Site](https://board.xcpcio.com/ccpc/10th/harbin?group=official), Oct 2024","-* 🏆**Gold Medalist** (17th place) -- [The 48<sup>th</sup> ICPC Asia Nanjing Regional Contest](https://board.xcpcio.com/icpc/48th/nanjing?group=official), Nov 2023","+<h2><span lang=\"en\">Selected Awards</span><span lang=\"zh\">竞赛成绩</span></h2>"," ","-**High school**","-* 🥉**Bronze Medalist** -- [National Olympiad in Informatics](https://www.noi.cn/upload/resources/file/2024/06/03/75fa469e47f6785fcb88c3dc01a7ec81.htm), Aug 2022","-* 🏆**1st Prize** (1st place) -- [National Olympiad in Informatics, Girls' Contest](https://www.noi.cn/upload/resources/file/2022/05/07/202205070930.htm), May 2022","-* 🥈**Silver Medalist** -- [National Olympiad in Informatics Summer Camp](https://www.noi.cn/upload/resources/file/2021/08/23/165993.html), Jul 2021","+<p lang=\"en\"><strong>College</strong></p>","+<p lang=\"zh\"><strong>大学</strong></p>"," ","-Breaking Barriers","-=====","-The team and I have been making consistent efforts to make competitive welcoming to everyone. The purpose of doing this, is to spread helpful knowledge (Yes, we believe many insights from competitive programming are very beneficial for undergraduate CS study) and provide a home for folks' interest in this field. We managed to overcome many difficulties, including:","-* **Gender exclusion:** Women remain underrepresented in competitive programming contests, and I have worked to increase their participation at our university. Since 2023, 6 girls have joined our team, and 4 of them have become gold medalists in ICPC Asia Regional Contests. I also led teams to participate in the CCPC Girls' Division for three consecutive years (2023 -- 2025), helping establish it as a tradition at our university. In Fall 2025, we won **1st place** in [The 11<sup>th</sup> CCPC Girls' Division](https://rl.algoux.org/ranklist/ccpc2025ladies), obtaining the first champion in this contest in our university’s history (see [WeChat post](https://mp.weixin.qq.com/s/FMxGKg2e8ZSot-qS9uJEfg)).","-<!--(and we became the 6th school to obtain a champion in this contest, after SJTU, DLUT, THU, FJNU and SUSTech)-->","-* **Knowledge barriers:** High-level awards in collegiate contests mostly go to students with prior high school OI experience (like me). To broaden access to beginners, I helped build a selection-and-training mechanism in our school. In 2024 fall, I formed a team where all members had **zero CNOI experience** and offered them **hands-on guidance from scratch**. They finally won a **Gold Medal** (31st place) in [The 49<sup>th</sup> ICPC Asia Chengdu Regional Contest](https://board.xcpcio.com/icpc/49th/chengdu?group=official).","-* **Imbalanced training quality:** Training quality for OI in high schools depends heavily their tiers and resources. Our team provided **weekend lectures** for CUHK-Shenzhen affiliated middle/high schools for OI training (I did a part of them). In 2025, their students achieved 13 prizes in CCF-CSP, with **1 first prize in CSP-S for the first time**, marking a significant breakthrough (see [WeChat post](https://mp.weixin.qq.com/s/28O-Q5V5HUT9cAIeHFAHdg)).","+<ul>","+  <li lang=\"en\">🥇<strong>Champion</strong> (1st place) -- <a href=\"https://rl.algoux.org/ranklist/ccpc2025ladies\">The 11<sup>th</sup> CCPC Girls' Division</a>, Oct 2025</li>","+  <li lang=\"zh\">🥇<strong>冠军</strong>（第 1 名）——<a href=\"https://rl.algoux.org/ranklist/ccpc2025ladies\">第十一届 CCPC 女生专场</a>，2025 年 10 月</li>","+  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (26th place) -- <a href=\"https://board.xcpcio.com/icpc/49th/ecfinal?group=official\">The 49<sup>th</sup> ICPC Asia East Continent Final Contest</a>, Dec 2024</li>","+  <li lang=\"zh\">🏆<strong>金牌</strong>（第 26 名）——<a href=\"https://board.xcpcio.com/icpc/49th/ecfinal?group=official\">第四十九届 ICPC 亚洲区东亚大陆总决赛</a>，2024 年 12 月</li>","+  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (6th place) -- <a href=\"https://board.xcpcio.com/icpc/49th/hongkong?group=official\">The 49<sup>th</sup> ICPC Asia Hong Kong Regional Contest</a>, Dec 2024</li>","+  <li lang=\"zh\">🏆<strong>金牌</strong>（第 6 名）——<a href=\"https://board.xcpcio.com/icpc/49th/hongkong?group=official\">第四十九届 ICPC 亚洲区香港站</a>，2024 年 12 月</li>","+  <li lang=\"en\">🥉<strong>2nd Runner-up</strong> (3rd place) -- <a href=\"https://board.xcpcio.com/ccpc/10th/zhengzhou?group=official\">The 10<sup>th</sup> CCPC Zhengzhou site</a>, Nov 2024</li>","+  <li lang=\"zh\">🥉<strong>季军</strong>（第 3 名）——<a href=\"https://board.xcpcio.com/ccpc/10th/zhengzhou?group=official\">第十届 CCPC 郑州站</a>，2024 年 11 月</li>","+  <li lang=\"en\">🥈<strong>1st Runner-up</strong> (2nd place) -- <a href=\"https://rl.algoux.org/ranklist/ccpc2024ladies\">The 10<sup>th</sup> CCPC Girls' Division</a>, Nov 2024</li>","+  <li lang=\"zh\">🥈<strong>亚军</strong>（第 2 名）——<a href=\"https://rl.algoux.org/ranklist/ccpc2024ladies\">第十届 CCPC 女生专场</a>，2024 年 11 月</li>","+  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (16th place) -- <a href=\"https://board.xcpcio.com/icpc/49th/chengdu?group=official\">The 49<sup>th</sup> ICPC Asia Chengdu Regional Contest</a>, Oct 2024</li>","+  <li lang=\"zh\">🏆<strong>金牌</strong>（第 16 名）——<a href=\"https://board.xcpcio.com/icpc/49th/chengdu?group=official\">第四十九届 ICPC 亚洲区成都站</a>，2024 年 10 月</li>","+  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (19th place) -- <a href=\"https://board.xcpcio.com/ccpc/10th/harbin?group=official\">The 10<sup>th</sup> CCPC Harbin Site</a>, Oct 2024</li>","+  <li lang=\"zh\">🏆<strong>金牌</strong>（第 19 名）——<a href=\"https://board.xcpcio.com/ccpc/10th/harbin?group=official\">第十届 CCPC 哈尔滨站</a>，2024 年 10 月</li>","+  <li lang=\"en\">🏆<strong>Gold Medalist</strong> (17th place) -- <a href=\"https://board.xcpcio.com/icpc/48th/nanjing?group=official\">The 48<sup>th</sup> ICPC Asia Nanjing Regional Contest</a>, Nov 2023</li>","+  <li lang=\"zh\">🏆<strong>金牌</strong>（第 17 名）——<a href=\"https://board.xcpcio.com/icpc/48th/nanjing?group=official\">第四十八届 ICPC 亚洲区南京站</a>，2023 年 11 月</li>","+</ul>"," ","-The team has also been doing other services, including:","-* **Voluntary final review lectures** for the following courses on programming, algorithms, discrete math, data structures, and database systems: CSC1001, CSC1003, CSC3001, CSC3100, and CSC3170. I did the overall organization for these events in 2024 and 2025. (WeChat posts for [2025](https://mp.weixin.qq.com/s/ZPVC79dJH5Pw2-A8m0DJ6A), [2024](https://mp.weixin.qq.com/s/17ouE0bikE4DW-8abUU3fw))","-* **CUHK-Shenzhen's annual competitive programming contests.** We welcome college and high school students nationwide to attend our contests and set two division for experienced and unexperienced participants. 300~500 students join our contest every year. I deeply participated the contest organization and execution in 2024, and served as the leading student organizer in 2025. Supported by these successful experiences, we held the ICPC China Shenzhen Invitational in 2026. (WeChat posts for [2025](https://mp.weixin.qq.com/s/TYJgMVE0ewP-qykDglk6Ig), [2024](https://mp.weixin.qq.com/s/HO15ApkFF3ACXIo66RgKEw))","\\ No newline at end of file","+<p lang=\"en\"><strong>High school</strong></p>","+<p lang=\"zh\"><strong>高中</strong></p>","+","+<ul>","+  <li lang=\"en\">🥉<strong>Bronze Medalist</strong> -- <a href=\"https://www.noi.cn/upload/resources/file/2024/06/03/75fa469e47f6785fcb88c3dc01a7ec81.htm\">National Olympiad in Informatics</a>, Aug 2022</li>","+  <li lang=\"zh\">🥉<strong>铜牌</strong>——<a href=\"https://www.noi.cn/upload/resources/file/2024/06/03/75fa469e47f6785fcb88c3dc01a7ec81.htm\">全国信息学奥林匹克联赛（NOI）</a>，2022 年 8 月</li>","+  <li lang=\"en\">🏆<strong>1st Prize</strong> (1st place) -- <a href=\"https://www.noi.cn/upload/resources/file/2022/05/07/202205070930.htm\">National Olympiad in Informatics, Girls' Contest</a>, May 2022</li>","+  <li lang=\"zh\">🏆<strong>一等奖</strong>（第 1 名）——<a href=\"https://www.noi.cn/upload/resources/file/2022/05/07/202205070930.htm\">全国信息学奥林匹克女生赛</a>，2022 年 5 月</li>","+  <li lang=\"en\">🥈<strong>Silver Medalist</strong> -- <a href=\"https://www.noi.cn/upload/resources/file/2021/08/23/165993.html\">National Olympiad in Informatics Summer Camp</a>, Jul 2021</li>","+  <li lang=\"zh\">🥈<strong>银牌</strong>——<a href=\"https://www.noi.cn/upload/resources/file/2021/08/23/165993.html\">全国信息学奥林匹克夏令营（NOI Summer Camp）</a>，2021 年 7 月</li>","+</ul>","+","+<h2><span lang=\"en\">Breaking Barriers</span><span lang=\"zh\">破除壁垒</span></h2>","+","+<p lang=\"en\">The team and I have been making consistent efforts to make competitive welcoming to everyone. The purpose of doing this, is to spread helpful knowledge (Yes, we believe many insights from competitive programming are very beneficial for undergraduate CS study) and provide a home for folks' interest in this field. We managed to overcome many difficulties, including:</p>","+<p lang=\"zh\">我和队伍一直致力于让算法竞赛对每个人都更加友好。我们的目的是传播有益的知识（我们坚信，竞赛编程中的许多思维方式对本科 CS 学习大有裨益），并为对这一领域感兴趣的同学提供归属感。我们克服了许多困难，包括：</p>","+","+<ul>","+  <li lang=\"en\"><strong>Gender exclusion:</strong> Women remain underrepresented in competitive programming contests, and I have worked to increase their participation at our university. Since 2023, 6 girls have joined our team, and 4 of them have become gold medalists in ICPC Asia Regional Contests. I also led teams to participate in the CCPC Girls' Division for three consecutive years (2023 -- 2025), helping establish it as a tradition at our university. In Fall 2025, we won <strong>1st place</strong> in <a href=\"https://rl.algoux.org/ranklist/ccpc2025ladies\">The 11<sup>th</sup> CCPC Girls' Division</a>, obtaining the first champion in this contest in our university's history (see <a href=\"https://mp.weixin.qq.com/s/FMxGKg2e8ZSot-qS9uJEfg\">WeChat post</a>).</li>","+  <li lang=\"zh\"><strong>性别壁垒：</strong>女性在算法竞赛中长期处于弱势地位。为此，我积极推动女生在校内的参赛。自 2023 年起，共有 6 名女生加入队伍，其中 4 人在 ICPC 亚洲区域赛中获得金牌。我连续三年（2023—2025）带队参加 CCPC 女生专场，推动其成为学校的固定传统。2025 年秋季，我们以<strong>全国第一</strong>的成绩赢得<a href=\"https://rl.algoux.org/ranklist/ccpc2025ladies\">第十一届 CCPC 女生专场</a>，这也是我校在该项目历史上的首个冠军（详见<a href=\"https://mp.weixin.qq.com/s/FMxGKg2e8ZSot-qS9uJEfg\">微信推文</a>）。</li>","+  <li lang=\"en\"><strong>Knowledge barriers:</strong> High-level awards in collegiate contests mostly go to students with prior high school OI experience (like me). To broaden access to beginners, I helped build a selection-and-training mechanism in our school. In 2024 fall, I formed a team where all members had <strong>zero CNOI experience</strong> and offered them <strong>hands-on guidance from scratch</strong>. They finally won a <strong>Gold Medal</strong> (31st place) in <a href=\"https://board.xcpcio.com/icpc/49th/chengdu?group=official\">The 49<sup>th</sup> ICPC Asia Chengdu Regional Contest</a>.</li>","+  <li lang=\"zh\"><strong>知识壁垒：</strong>大学联赛中的高奖项大多由具备高中 OI 经验的选手（如我）摘得。为降低入门门槛，我参与建立了学校的选拔与培训机制。2024 年秋季，我组建了一支成员<strong>均无 OI 经验</strong>的队伍，并为其提供<strong>从零开始的实操指导</strong>。他们最终在<a href=\"https://board.xcpcio.com/icpc/49th/chengdu?group=official\">第四十九届 ICPC 亚洲区成都站</a>荣获<strong>金牌</strong>（第 31 名）。</li>","+  <li lang=\"en\"><strong>Imbalanced training quality:</strong> Training quality for OI in high schools depends heavily their tiers and resources. Our team provided <strong>weekend lectures</strong> for CUHK-Shenzhen affiliated middle/high schools for OI training (I did a part of them). In 2025, their students achieved 13 prizes in CCF-CSP, with <strong>1 first prize in CSP-S for the first time</strong>, marking a significant breakthrough (see <a href=\"https://mp.weixin.qq.com/s/28O-Q5V5HUT9cAIeHFAHdg\">WeChat post</a>).</li>","+  <li lang=\"zh\"><strong>培训资源不均：</strong>高中 OI 的培训质量高度依赖学校的层次与资源。我们团队为港中大（深圳）附属中学提供<strong>周末讲座</strong>进行 OI 培训（我主讲了其中一部分）。2025 年，附校学生在 CCF-CSP 中共获 13 项奖项，其中<strong>首次斩获 CSP-S 一等奖</strong>，实现重大突破（详见<a href=\"https://mp.weixin.qq.com/s/28O-Q5V5HUT9cAIeHFAHdg\">微信推文</a>）。</li>","+</ul>","+","+<p lang=\"en\">The team has also been doing other services, including:</p>","+<p lang=\"zh\">队伍还提供了以下其他服务：</p>","+","+<ul>","+  <li lang=\"en\"><strong>Voluntary final review lectures</strong> for the following courses on programming, algorithms, discrete math, data structures, and database systems: CSC1001, CSC1003, CSC3001, CSC3100, and CSC3170. I did the overall organization for these events in 2024 and 2025. (WeChat posts for <a href=\"https://mp.weixin.qq.com/s/ZPVC79dJH5Pw2-A8m0DJ6A\">2025</a>, <a href=\"https://mp.weixin.qq.com/s/17ouE0bikE4DW-8abUU3fw\">2024</a>)</li>","+  <li lang=\"zh\"><strong>自愿期末复习讲座</strong>，覆盖程序设计、算法、离散数学、数据结构与数据库系统等课程（CSC1001、CSC1003、CSC3001、CSC3100、CSC3170）。我在 2024 年和 2025 年总负责了这些活动的统筹组织。（微信推文：<a href=\"https://mp.weixin.qq.com/s/ZPVC79dJH5Pw2-A8m0DJ6A\">2025 年</a>、<a href=\"https://mp.weixin.qq.com/s/17ouE0bikE4DW-8abUU3fw\">2024 年</a>）</li>","+  <li lang=\"en\"><strong>CUHK-Shenzhen's annual competitive programming contests.</strong> We welcome college and high school students nationwide to attend our contests and set two division for experienced and unexperienced participants. 300~500 students join our contest every year. I deeply participated the contest organization and execution in 2024, and served as the leading student organizer in 2025. Supported by these successful experiences, we held the ICPC China Shenzhen Invitational in 2026. (WeChat posts for <a href=\"https://mp.weixin.qq.com/s/TYJgMVE0ewP-qykDglk6Ig\">2025</a>, <a href=\"https://mp.weixin.qq.com/s/HO15ApkFF3ACXIo66RgKEw\">2024</a>)</li>","+  <li lang=\"zh\"><strong>港中大（深圳）年度算法竞赛。</strong>我们面向全国高校及高中生举办比赛，设有新手组与经验组。每年有 300～500 名学生参赛。我在 2024 年深度参与了赛事的组织与执行，并在 2025 年担任学生主要负责人。基于这些成功经验，我们于 2026 年承办了 ICPC 中国深圳邀请赛。（微信推文：<a href=\"https://mp.weixin.qq.com/s/TYJgMVE0ewP-qykDglk6Ig\">2025 年</a>、<a href=\"https://mp.weixin.qq.com/s/HO15ApkFF3ACXIo66RgKEw\">2024 年</a>）</li>","+</ul>"]}],"originalFile":"---\ntitle: \"Competitive Programming\"\npermalink: /competitive-programming/\nauthor_profile: true\n---\n\nI have been participating competitive programming since junior high school, attending the **Olympiad in Informatics (OI)** in high school as well as the **International/China Collegiate Programming Contest (ICPC/CCPC)** in college.\n\nAt CUHK-Shenzhen, I served as the **student leader** of the university's 30-member competitive programming team from Jun 2024 to Dec 2025, coached by [Prof. Yixiang Fang](https://fangyixiang.github.io/) and [Prof. Chenhao Ma](https://chenhao-ma.github.io/), with additional advice from [Prof. Jingbang Chen](http://chenjb1997.github.io/). During this time, besides contest participation, we continuously provided related resources to the broader university community.\n\n<div style=\"display: flex; gap: 10px;\">\n  <figure style=\"width: 29.45%; text-align: center;\">\n    <img src=\"{{ '/images/CCPC-girls.jpg' | relative_url }}\" style=\"width: 100%;\">\n    <figcaption>Winning CCPC Girls' Division, placing 1st nationwide, together with Xiaoxiao and Jiuzhi.</figcaption>\n  </figure>\n\n  <figure style=\"width: 33.55%; text-align: center;\">\n    <img src=\"{{ '/images/GBAIPC.jpg' | relative_url }}\" style=\"width: 100%;\">\n    <figcaption>Contributed to the organization of the 2025 Canton-Hong Kong-Macau Greater Bay Area Programming Contest, a part of <a href=\"https://www.slai.edu.cn/\">SLAI</a>'s first cohort admission.</figcaption>\n  </figure>\n</div>\n\nSelected Awards\n=====\n**College**\n* 🥇**Champion** (1st place) -- [The 11<sup>th</sup> CCPC Girls' Division](https://rl.algoux.org/ranklist/ccpc2025ladies), Oct 2025\n* 🏆**Gold Medalist** (26th place) -- [The 49<sup>th</sup> ICPC Asia East Continent Final Contest](https://board.xcpcio.com/icpc/49th/ecfinal?group=official), Dec 2024\n* 🏆**Gold Medalist** (6th place) -- [The 49<sup>th</sup> ICPC Asia Hong Kong Regional Contest](https://board.xcpcio.com/icpc/49th/hongkong?group=official), Dec 2024\n* 🥉**2nd Runner-up** (3rd place) -- [The 10<sup>th</sup> CCPC Zhengzhou site](https://board.xcpcio.com/ccpc/10th/zhengzhou?group=official), Nov 2024\n* 🥈**1st Runner-up** (2nd place) -- [The 10<sup>th</sup> CCPC Girls' Division](https://rl.algoux.org/ranklist/ccpc2024ladies), Nov 2024\n* 🏆**Gold Medalist** (16th place) -- [The 49<sup>th</sup> ICPC Asia Chengdu Regional Contest](https://board.xcpcio.com/icpc/49th/chengdu?group=official), Oct 2024\n* 🏆**Gold Medalist** (19th place) -- [The 10<sup>th</sup> CCPC Harbin Site](https://board.xcpcio.com/ccpc/10th/harbin?group=official), Oct 2024\n* 🏆**Gold Medalist** (17th place) -- [The 48<sup>th</sup> ICPC Asia Nanjing Regional Contest](https://board.xcpcio.com/icpc/48th/nanjing?group=official), Nov 2023\n\n**High school**\n* 🥉**Bronze Medalist** -- [National Olympiad in Informatics](https://www.noi.cn/upload/resources/file/2024/06/03/75fa469e47f6785fcb88c3dc01a7ec81.htm), Aug 2022\n* 🏆**1st Prize** (1st place) -- [National Olympiad in Informatics, Girls' Contest](https://www.noi.cn/upload/resources/file/2022/05/07/202205070930.htm), May 2022\n* 🥈**Silver Medalist** -- [National Olympiad in Informatics Summer Camp](https://www.noi.cn/upload/resources/file/2021/08/23/165993.html), Jul 2021\n\nBreaking Barriers\n=====\nThe team and I have been making consistent efforts to make competitive welcoming to everyone. The purpose of doing this, is to spread helpful knowledge (Yes, we believe many insights from competitive programming are very beneficial for undergraduate CS study) and provide a home for folks' interest in this field. We managed to overcome many difficulties, including:\n* **Gender exclusion:** Women remain underrepresented in competitive programming contests, and I have worked to increase their participation at our university. Since 2023, 6 girls have joined our team, and 4 of them have become gold medalists in ICPC Asia Regional Contests. I also led teams to participate in the CCPC Girls' Division for three consecutive years (2023 -- 2025), helping establish it as a tradition at our university. In Fall 2025, we won **1st place** in [The 11<sup>th</sup> CCPC Girls' Division](https://rl.algoux.org/ranklist/ccpc2025ladies), obtaining the first champion in this contest in our university’s history (see [WeChat post](https://mp.weixin.qq.com/s/FMxGKg2e8ZSot-qS9uJEfg)).\n<!--(and we became the 6th school to obtain a champion in this contest, after SJTU, DLUT, THU, FJNU and SUSTech)-->\n* **Knowledge barriers:** High-level awards in collegiate contests mostly go to students with prior high school OI experience (like me). To broaden access to beginners, I helped build a selection-and-training mechanism in our school. In 2024 fall, I formed a team where all members had **zero CNOI experience** and offered them **hands-on guidance from scratch**. They finally won a **Gold Medal** (31st place) in [The 49<sup>th</sup> ICPC Asia Chengdu Regional Contest](https://board.xcpcio.com/icpc/49th/chengdu?group=official).\n* **Imbalanced training quality:** Training quality for OI in high schools depends heavily their tiers and resources. Our team provided **weekend lectures** for CUHK-Shenzhen affiliated middle/high schools for OI training (I did a part of them). In 2025, their students achieved 13 prizes in CCF-CSP, with **1 first prize in CSP-S for the first time**, marking a significant breakthrough (see [WeChat post](https://mp.weixin.qq.com/s/28O-Q5V5HUT9cAIeHFAHdg)).\n\nThe team has also been doing other services, including:\n* **Voluntary final review lectures** for the following courses on programming, algorithms, discrete math, data structures, and database systems: CSC1001, CSC1003, CSC3001, CSC3100, and CSC3170. I did the overall organization for these events in 2024 and 2025. (WeChat posts for [2025](https://mp.weixin.qq.com/s/ZPVC79dJH5Pw2-A8m0DJ6A), [2024](https://mp.weixin.qq.com/s/17ouE0bikE4DW-8abUU3fw))\n* **CUHK-Shenzhen's annual competitive programming contests.** We welcome college and high school students nationwide to attend our contests and set two division for experienced and unexperienced participants. 300~500 students join our contest every year. I deeply participated the contest organization and execution in 2024, and served as the leading student organizer in 2025. Supported by these successful experiences, we held the ICPC China Shenzhen Invitational in 2026. (WeChat posts for [2025](https://mp.weixin.qq.com/s/TYJgMVE0ewP-qykDglk6Ig), [2024](https://mp.weixin.qq.com/s/HO15ApkFF3ACXIo66RgKEw))","userModified":false},"tool_use_id":"toolu_01NhX8dmqHJvuGEJYHa3nw24","duration_ms":104,"logged_at":"2026-06-17T23:24:48"}
{"session_id":"b606e9ca-b863-4906-850e-562afca2707c","transcript_path":"/home/youran/.claude/projects/-mnt-d-research-YouranSun-github-io/b606e9ca-b863-4906-850e-562afca2707c.jsonl","cwd":"/mnt/d/research/YouranSun.github.io","permission_mode":"bypassPermissions","effort":{"level":"high"},"hook_event_name":"PreToolUse","tool_name":"Write","tool_input":{"file_path":"/mnt/d/research/YouranSun.github.io/_pages/misc.md","content":"---\ntitle: \"\"\npermalink: /misc/\nauthor_profile: true\n---\n\n<h1><span lang=\"en\">🏔️ The virtuous love the mountains.</span><span lang=\"zh\">🏔️ 仁者乐山。</span></h1>\n\n<ul>\n  <li lang=\"en\"><em>The wise love the water; the virtuous love the mountains. (The Analects, Yongye)</em></li>\n  <li lang=\"zh\"><em>智者乐水，仁者乐山。——《论语 · 雍也》</em></li>\n</ul>\n\n<!-- I firmly believe people should behave and act morally. If one cannot fully follow it, at least he should not forget it. -->\n\n<!-- The Mountain stands for silence, strength and steadfastness. It stands there, unshaken by any force. It has a magnanimous heart and supports the rest through its presence, as another saying goes -- *The Earth's condition is receptive devotion. The superior man, in accordance with this, carries the outer world with his virtue.（\"地势坤，君子以厚德载物。\"）* -->\n\n<h2><span lang=\"en\">🎧 Music</span><span lang=\"zh\">🎧 音乐</span></h2>\n\n<p lang=\"en\">I have been a fan of Chinese Rock/Indie (<a href=\"https://music.apple.com/album/%E4%B8%87%E8%83%BD%E9%9D%92%E5%B9%B4%E6%97%85%E5%BA%97/1538548871\">1</a>, <a href=\"https://music.apple.com/album/%E5%86%80%E8%A5%BF%E5%8D%97%E6%9E%97%E8%B7%AF%E8%A1%8C/1545534900\">2</a>, <a href=\"https://music.apple.com/album/%E8%8F%8A%E8%8A%B1%E5%A4%9C%E8%A1%8C%E8%BB%8D/681818004\">3</a>, <a href=\"https://music.apple.com/album/%E6%96%B0%E9%95%BF%E5%BE%81%E8%B7%AF%E4%B8%8A%E7%9A%84%E6%91%87%E6%BB%9A/1585625540\">4</a>, <a href=\"https://music.apple.com/album/before-the-applause-rebuilding-the-rights-of-statues/1700446170\">5</a>, <a href=\"https://music.apple.com/us/album/%E6%99%82%E4%BB%A3%E5%9C%A8%E5%8F%AC%E5%96%9A/1611249232\">6</a>, <a href=\"https://music.apple.com/album/%E9%A2%B1%E9%A2%A8%E4%BE%86%E4%BA%86-live/1474226597\">7</a>, <a href=\"https://music.apple.com/album/%E9%A3%9B%E8%A1%8C%E5%99%A8%E7%9A%84%E5%9F%B7%E8%A1%8C%E9%80%B1%E6%9C%9F/1443637757\">8</a>, <a href=\"https://music.apple.com/album/%E9%A3%9B%E5%87%BA%E8%BF%B7%E6%A8%93-2024-mix/1775386936\">9</a>, <a href=\"https://music.apple.com/album/%E4%BB%96%E5%80%91%E8%AA%AA%E5%BF%98%E4%BA%86%E6%90%96%E6%BB%BE%E6%9C%89%E5%95%8F%E9%A1%8C/1481432266\">10</a>, <a href=\"https://biupiukiu.net/gq/sxdhf_21demos.zip\">11</a>, <a href=\"https://music.apple.com/us/album/%E9%86%9C%E5%A5%B4%E5%85%92/1676735354\">12</a>, <a href=\"https://music.apple.com/album/%E5%86%AC-%E6%9C%AA%E4%BA%86/1593446659\">13</a>, <a href=\"https://music.apple.com/album/0-7/1752486971\">14</a>, <a href=\"https://music.apple.com/us/album/%E5%8A%B3%E5%8A%A8%E4%B9%8B%E4%BD%99/1597320706\">15</a>, and etc.) for years. <!-- [16](https://music.apple.com/album/%E5%BF%83%E8%A6%81%E9%87%8E/1808445272), [17](https://music.apple.com/album/chinese-football/1237133811), [18](https://music.apple.com/album/%E5%A4%9A%E7%B1%B3%E5%8A%9B%E9%AB%98%E5%A8%81%E5%A8%81%E7%BB%B4%E5%88%A9%E6%98%9F/1563362823), [19](https://music.apple.com/us/album/california-nebula/1459960630), [20](https://music.apple.com/album/%E4%B8%89%E6%B1%9F%E5%A4%9C%E9%81%8A-the-end-of-delusion-and-the-last-ningbonese/1695055680). --> I was in the audience for Omnipotent Youth Hotel（万能青年旅店）'s <a href=\"https://www.bilibili.com/video/BV1Xi421Z7bD\"><em>Inside the Cable Temple</em> Asian Tour</a> in Hong Kong (it was a super awesome performance with passionate audience).</p>\n<p lang=\"zh\">多年来，我是中国摇滚/独立音乐的忠实听众（<a href=\"https://music.apple.com/album/%E4%B8%87%E8%83%BD%E9%9D%92%E5%B9%B4%E6%97%85%E5%BA%97/1538548871\">1</a>、<a href=\"https://music.apple.com/album/%E5%86%80%E8%A5%BF%E5%8D%97%E6%9E%97%E8%B7%AF%E8%A1%8C/1545534900\">2</a>、<a href=\"https://music.apple.com/album/%E8%8F%8A%E8%8A%B1%E5%A4%9C%E8%A1%8C%E8%BB%8D/681818004\">3</a>、<a href=\"https://music.apple.com/album/%E6%96%B0%E9%95%BF%E5%BE%81%E8%B7%AF%E4%B8%8A%E7%9A%84%E6%91%87%E6%BB%9A/1585625540\">4</a>、<a href=\"https://music.apple.com/album/before-the-applause-rebuilding-the-rights-of-statues/1700446170\">5</a>、<a href=\"https://music.apple.com/us/album/%E6%99%82%E4%BB%A3%E5%9C%A8%E5%8F%AC%E5%96%9A/1611249232\">6</a>、<a href=\"https://music.apple.com/album/%E9%A2%B1%E9%A2%A8%E4%BE%86%E4%BA%86-live/1474226597\">7</a>、<a href=\"https://music.apple.com/album/%E9%A3%9B%E8%A1%8C%E5%99%A8%E7%9A%84%E5%9F%B7%E8%A1%8C%E9%80%B1%E6%9C%9F/1443637757\">8</a>、<a href=\"https://music.apple.com/album/%E9%A3%9B%E5%87%BA%E8%BF%B7%E6%A8%93-2024-mix/1775386936\">9</a>、<a href=\"https://music.apple.com/album/%E4%BB%96%E5%80%91%E8%AA%AA%E5%BF%98%E4%BA%86%E6%90%96%E6%BB%BE%E6%9C%89%E5%95%8F%E9%A1%8C/1481432266\">10</a>、<a href=\"https://biupiukiu.net/gq/sxdhf_21demos.zip\">11</a>、<a href=\"https://music.apple.com/us/album/%E9%86%9C%E5%A5%B4%E5%85%92/1676735354\">12</a>、<a href=\"https://music.apple.com/album/%E5%86%AC-%E6%9C%AA%E4%BA%86/1593446659\">13</a>、<a href=\"https://music.apple.com/album/0-7/1752486971\">14</a>、<a href=\"https://music.apple.com/us/album/%E5%8A%B3%E5%8A%A8%E4%B9%8B%E4%BD%99/1597320706\">15</a> 等）。我曾现场观看万能青年旅店的<a href=\"https://www.bilibili.com/video/BV1Xi421Z7bD\">《有线电视的鬼神庙》亚洲巡演</a>香港场，那是一场令人叹为观止的演出，现场观众热情非凡。</p>\n\n<div style=\"display: flex;\">\n  <figure style=\"width: 35%; text-align: center;\">\n    <img src=\"{{ '/images/万能青年旅店.jpg' | relative_url }}\" style=\"width: 100%;\">\n    <figcaption>\n      <span lang=\"en\">Omnipotent Youth Hotel / Inside the Cable Temple Asian Tour / Hong Kong / March 2024</span>\n      <span lang=\"zh\">万能青年旅店 / 有线电视的鬼神庙亚洲巡演 / 香港 / 2024 年 3 月</span>\n    </figcaption>\n  </figure>\n</div>\n"},"tool_use_id":"toolu_011YRFVKbaVupMQheGXD7rui","logged_at":"2026-06-17T23:25:37"}
